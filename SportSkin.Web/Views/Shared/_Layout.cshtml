<!DOCTYPE html>
<html lang="es" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportSkin</title>
    <script type="importmap"></script>
    <!--Preconección (mejorar carga CDN)-->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
    <!--Font Awesome-->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <!--Boostrap Multiselect-->  
    <link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css" />
    <!--Tom Select-->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/css/tom-select.css" rel="stylesheet">
    <!--File pond y sus plugins-->
    <link href="https://unpkg.com/filepond@4/dist/filepond.css" rel="stylesheet" />
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css" rel="stylesheet" />
    <!--Estilos propios-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100 bg-body">

    <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-body border rounded" href="#mainContent">
        Saltar al contenido
    </a>

    <header class="sticky-top">
        @await Html.PartialAsync("_Menu")
    </header>

    <main id="mainContent" class="flex-grow-1">
        <div class="container py-3">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto border-top">
        <div class="container py-3 small text-muted d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">
            <div>
                &copy; @DateTime.Now.Year - SportSkin by Rodrigo Herrera y Jeremy Fuentes
            </div>
            <div>
                <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    "La piel del deporte"
                </a>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <!--Bootstrap-->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!--Jquery-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!--Datatables-->
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <!--SweetAlert 2-->
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <!--Boostrap Multiselect-->
    <script src="~/lib/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>
    <!-- i18next: bundles en lib/i18next/, config en js/i18n/ -->
    <!-- BrowserLanguageDetector eliminado: persistencia manejada manualmente -->
    <script src="~/lib/i18next/i18next.min.js" asp-append-version="true"></script>
    <script src="~/lib/i18next/i18next-http-backend.min.js" asp-append-version="true"></script>
    <script src="~/js/i18n/sportskin-i18n.js" asp-append-version="true"></script>
    <!--Tom select-->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/js/tom-select.complete.min.js"></script>
    <!--File Pond y sus plugins-->
    <script src="https://unpkg.com/filepond@4/dist/filepond.js"></script>
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>
    <!--Jquery Validation-->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <!--Signal R-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <!-- SWEETALERT NOTIFICATION -->
    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;

        <script type="text/javascript">
            const payload = @Html.Raw(notificacion);

            if (payload) {
                Swal.fire(payload);
            }        
        </script>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!--Vista parcial de Inicio de Sesión-->
    <partial name="_Login"/>
    <partial name="_EditarUsuario" />
    <partial name="_CambiarContrasenna" />

    <script>
        //Función encargada de mostrar un mensaje de inicio o cierre de sesión a partir de una variable auxiliar en sessionStorage.
        (function () {
            const mensajeSesion = sessionStorage.getItem("mensajeCambioSesion");

            if (!mensajeSesion)
                return;

            const mensajeSesionObject = JSON.parse(mensajeSesion);
            sessionStorage.removeItem("mensajeCambioSesion");
            
            Swal.fire({
                icon: mensajeSesionObject.icon,
                title: mensajeSesionObject.title,
                toast: true,
                position: "top-end",
                timer: 4000,
                timerProgressBar: true,
                showCloseButton: true,
                showConfirmButton: false,
                customClass: { closeButton: "toast-close-button" }
            });
        })();
    </script>
</body>
</html>
