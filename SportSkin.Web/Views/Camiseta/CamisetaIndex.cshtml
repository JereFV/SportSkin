@model SportSkin.Web.ViewModels.CamisetaViewModel

@{
    ViewData["Title"] = "Camisetas";
    var total = Model?.Camisetas?.Count() ?? 0;
}

<!--Contenedor auxiliar, usado para renderizar el modal de edición.-->
<div id="contenedorModalEditar">
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">
            <i class="fa-solid fa-shirt text-primary"></i>&nbsp;
            <span data-i18n="shirts:myShirts"></span>
        </h1>

        <p class="text-muted mb-0">
            <span data-i18n="shirts:totalLabel"></span>
            <strong>@total</strong>.
        </p>

        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#createModal" style="border-radius:12px; margin-top: 0.5rem">
            <i class="bi bi-plus-circle"></i>
            <span data-i18n="actions.addShirt"> </span>
        </button>
    </div>
    <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle d-flex align-items-center gap-2"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-funnel"></i>
            <span data-i18n="filters.title"></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li>
                <h6 class="dropdown-header" data-i18n="filters.byStatus"></h6>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "vendidos" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="vendidos">
                    <i class="bi bi-check-circle text-success"></i>
                    <span data-i18n="filters.sold"></span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "ensubasta" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="ensubasta">
                    <i class="fa-solid fa-gavel text-primary"></i>
                    <span data-i18n="status.inAuction"></span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "sinsubasta" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="sinsubasta">
                    <i class="bi bi-tag text-secondary"></i>
                    <span data-i18n="status.available"></span>
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-action="CamisetaIndex">
                    <i class="bi bi-x-circle text-danger"></i>
                    <span data-i18n="actions.clearFilter"></span>
                </a>
            </li>
        </ul>
    </div>
</div>

@if (Model?.Camisetas == null || !Model.Camisetas.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div data-i18n="shirts:noShirts"></div>
    </div>
}
else
{
    <section aria-label="Listado de camisetas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model.Camisetas)
            {
                var primeraImagen = item.ImagenesCamiseta?.FirstOrDefault();
                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <div class="rounded-top overflow-hidden bg-body-tertiary" style="height:320px">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="@item.Nombre" loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                    </div>

                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-1 text-truncate" title="@item.Nombre">
                            @item.Nombre
                        </h2>
                        <div class="d-flex gap-2 mb-0">
                            <span class="badge rounded-pill bg-secondary px-3 py-2">
                                @(item.CondicionCamisetaNavigation?.Nombre ?? "—")
                            </span>
                            <span class="badge rounded-pill px-3 py-2
                                        @(item.EstadoCamisetaNavigation?.Nombre switch
                                  {
                                      "Disponible" => "bg-success",
                                      "En Subasta" => "bg-warning",
                                      "Vendida" => "bg-danger",
                                      _ => "bg-secondary"
                                  })">
                            @(item.EstadoCamisetaNavigation?.Nombre ?? "—")
                        </span>
                    </div>
                </div>

                    <div class="card-footer bg-body border-0 pt-0 pb-2">
                        <div class="d-flex gap-2 px-2">
                            <a asp-controller="Subasta" asp-action="Create"
                               asp-route-id="@item.IdCamiseta"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-cart-check me-1"></i>
                                <span data-i18n="actions.auction"></span>
                            </a>
                            <div class="dropdown ms-auto">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown">
                                    <span data-i18n="actions.actionsS"></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a asp-controller="Camiseta" asp-action="CamisetaDetails"
                                                asp-route-id="@item.IdCamiseta" class="dropdown-item">
                                            <i class="bi bi-info-circle me-2 text-info"></i>
                                            <span data-i18n="actions.details"></span>
                                        </a>
                                    </li>

                                    <li>
                                        <input type="hidden" name="id" />
                                        <button type="button"
                                                class="dropdown-item"
                                                onclick="cargarModalEditar(@item.IdCamiseta, '@item.EstadoCamisetaNavigation?.Nombre')">
                                            <i class="bi bi-pencil me-2 text-warning"></i>
                                            <span data-i18n="actions.edit"></span>
                                        </button>                                      
                                    </li>
                                    
                                    <li>
                                        <input type="hidden" name="id" />
                                            @if (item.EstadoRegistro)
                                            {
                                                <form asp-controller="Camiseta" asp-action="ChangeState" asp-route-id="@item.IdCamiseta">
                                                    <button type="submit" class="dropdown-item" onclick="return ChangeState(event, 'deshabilitar','@item.Nombre',this, '@item.EstadoCamisetaNavigation?.Nombre')">
                                                        <i class="bi me-2 @(item.EstadoRegistro ? "bi-x-circle text-danger" : "bi-check-circle text-sucess")"></i>
                                                        <span data-i18n="actions.@(item.EstadoRegistro ? "disable" : "enable")"></span>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Camiseta" asp-action="ChangeState" asp-route-id="@item.IdCamiseta">
                                                    <button type="submit" class="dropdown-item" onclick="return ChangeState(event, 'habilitar','@item.Nombre',this, '@item.EstadoCamisetaNavigation?.Nombre')">
                                                        <i class="bi me-2 @(item.EstadoRegistro ? "bi-x-circle text-danger" : "bi-check-circle text-sucess")"></i>
                                                        <span data-i18n="actions.@(item.EstadoRegistro ? "disable" : "enable")"></span>
                                                    </button>
                                                </form>
                                            }

                                                                            
                                    </li>                                                                    
                                </ul>
                            </div>
                        </div>                                             
                    </div>
                </article>
            </div>
                }
        </div>
    </section>
}

@section Scripts {
    <partial name="_CamisetaCreate" model="Model?.CreacionCamiseta" />

    <script>
        // Variable global para controlar las imagenes borradas.
        let idsImagenesEliminadas = [];

        $(document).ready(function() {
            //Registro de plugins de filepond.
            FilePond.registerPlugin(
                 FilePondPluginImagePreview, //Renderizado de preview de imagenes.
                 FilePondPluginFileValidateType, //Validación de tipos de archivos.
            );

            //Inicializa controles del modal de agregar camisetas.
            inicializarControles('nuevaCamisetaForm');
        });

        //Inicialización dinámica de controles del formulario según el contenedor indicado.
        function inicializarControles (containerId, datosPrevios = {}) {
            const scope = document.querySelector(`#${containerId}`);

            $(scope.querySelector('#categorias')).multiselect({
                nonSelectedText: 'Seleccione una o más categorías',
                buttonWidth: '100%',
                buttonTextAlignment: 'left',
                allSelectedText: false,
                numberDisplayed: 0
            });

            let selectEquipo = new TomSelect(scope.querySelector('#equipo'), {               
                valueField: 'id',
                labelField: 'name',
                searchField: 'name',
                loadThrottle: 400,
                load: function(query, callback) {
                    let url = '/Camiseta/ListEquipos?filtro=' + encodeURIComponent(query);

                    fetch(url)
                        .then(response => response.json())
                        .then(json => {
                            callback(json);
                        }).catch(()=>{
                            callback();
                        });
                },
                shouldLoad: function(query) {
                    //Solo ejecuta si se digitan 3 o más caracteres.
                    return query.length >= 3;
                },
                onChange: function(value) {
                    if (value) {
                        //Habilita el campo de jugador y limpia las opciones al cambiar el equipo seleccionado.
                        selectJugador.enable();
                        selectJugador.clear();
                        selectJugador.clearOptions();

                        //Almacena la información del equipo seleccionado en un campo hidden.
                        scope.querySelector('#equipoJSON').value = JSON.stringify(this.options[value]);
                    } else {
                        //Al borrar el equipo se deshabilita el campo de jugador.
                        selectJugador.disable();
                        selectJugador.clear();

                        //Limpieza del contenedor de la información del equipo.
                        scope.querySelector('#equipoJSON').value = "";
                    }
                },
                render: {
                    no_results: function(data, escape) {
                        return '<div class="no-results">No se encontraron equipos...</div>';
                    }
                },
            });

            let selectJugador = new TomSelect(scope.querySelector('#jugador'), {                
                valueField: 'id',
                labelField: 'name',
                searchField: 'name',
                loadThrottle: 400,
                load: function(query, callback) {
                    let url = '/Camiseta/ListJugadores?filtro=' + encodeURIComponent(query) + '&idEquipo=' + encodeURIComponent(selectEquipo.getValue());

                    fetch(url)
                        .then(response => response.json())
                        .then(json => {
                            callback(json);
                        }).catch(()=>{
                            callback();
                        });
                },
                shouldLoad: function(query) {
                    //Solo ejecuta si se digitan 3 o más caracteres.
                    return query.length >= 3;
                },
                render: {
                    no_results: function(data, escape) {
                        return '<div class="no-results">No se encontraron jugadores para el valor digitado y el equipo seleccionado...</div>';
                    },
                },
                onChange: function(value) {
                    if (value) {
                        //Limpieza de opciones en el select de temporada.
                        selectTemporada.clear();
                        selectTemporada.clearOptions();

                        fetch('/Camiseta/ListTemporadas?idEquipo=' + encodeURIComponent(selectEquipo.getValue()) + '&idJugador=' + encodeURIComponent(selectJugador.getValue()))
                            .then(response => response.json())
                            .then(json => {
                                //Agrega cada una de los valores devueltos  por el controlador como opción en el select de temporada.
                                json.forEach((item, index) => {
                                   selectTemporada.addOption({
                                       id: index,
                                       anio: item
                                   });
                                });

                                selectTemporada.enable();
                            }).catch((error)=>{
                                console.error(error)
                            });

                        //Almacena la información del jugador seleccionado en un campo hidden.
                        scope.querySelector('#jugadorJSON').value = JSON.stringify(this.options[value]);
                    } else {
                        //Al borrar el jugador se borra y deshabilita el campo de temporada.
                        selectTemporada.disable();
                        selectTemporada.clear();

                        //Limpieza del contenedor de la información del jugador.
                        scope.querySelector('#jugadorJSON').value = '';
                    }
                },
            });

            let selectTemporada = new TomSelect(scope.querySelector('#temporada'), {               
                valueField: 'anio',
                labelField: 'anio',
                searchField: [],
                render: {
                    no_results: function(data, escape) {
                        return '<div class="no-results">No se encontraron temporadas para el jugador y equipo seleccionado..</div>';
                    },
                },
            });

            //Precargado de campos para el formulario de edición.
            if (datosPrevios.equipo) {
                selectEquipo.addOption(datosPrevios.equipo);
                selectEquipo.addItem(datosPrevios.equipo.id);
            }

            if (datosPrevios.jugador) {
                selectJugador.addOption(datosPrevios.jugador);
                selectJugador.addItem(datosPrevios.jugador.id);
            }
            else
                selectJugador.disable();

            if (datosPrevios.temporada) {
                selectTemporada.addOption({ anio: datosPrevios.temporada });
                selectTemporada.addItem(datosPrevios.temporada);
                selectTemporada.enable();
            }
            else
                selectTemporada.disable();

            const pond = FilePond.create(scope.querySelector('.filepond'),{
                credits: false,
                labelIdle: 'Arrastra tus imágenes o adjuntalas aquí: <span class="filepond--label-action link-primary">Seleccionar imagen</span>',
                acceptedFileTypes: ['image/png', 'image/jpeg'],
                itemInsertLocation: 'after',
                imagePreviewHeight: 245, // Altura fija para que todas las miniaturas midan lo mismo
                storeAsFile: true,
                files: datosPrevios.imagenes || [],
                server: {           
                    load: (source, load, error, progress, abort, headers) => {
                        fetch(source).then(res => res.blob()).then(load).catch(error);
                    }
                }
            });

            if (datosPrevios) {
                // Evento que se dispara al quitar un archivo.
                pond.on('removefile', (error, file) => {
                    // Si el archivo tiene metadatos, ya existia previamente.
                    const id = file.getMetadata('id');

                    if (id) {
                        idsImagenesEliminadas.push(id);                        

                        // Actualizamos un input hidden en el formulario para que viaje al controlador
                        document.querySelector(`#${containerId} #IdsImagenesEliminadas`).value = JSON.stringify(idsImagenesEliminadas);
                    }
                });
            }

        }

        //Evento submit del formulario de creación de camisetas.
        document.getElementById("nuevaCamisetaForm").addEventListener("submit", async function (e) {
            try {
                e.preventDefault();

                //Valida que todos los campos cumplan con las especificaciones necesarias.
                if (!$("#nuevaCamisetaForm").valid())
                    return;

                const form = this;
                const formData = new FormData(form);

                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData
                });

                const responseJson = await response.json();

                switch (responseJson.statusCode)
                {
                    case "sucess":
                        Swal.fire({
                            icon: 'success',
                            title: 'Camiseta creada',
                            text: responseJson.message,
                        }).then(() => {
                            //Recarga el listado al finalizar la ejecucción.
                            location.reload();
                        });

                        break;
                    case "warning":
                        Swal.fire({
                            icon: 'warning',
                            title: 'Advertencia',
                            html: responseJson.message,
                        });

                        break;

                    case "error":
                        Swal.fire({
                            icon: 'error',
                            title: 'Error en creación de camiseta',
                            text: responseJson.message,
                        });

                        break;
                }
            }
            catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error en creación de camiseta',
                    text: 'Ha ocurrido un error al intentar crear la camiseta. Por favor intente nuevamente o contacte a soporte del sistema.'
                });

                console.log(error.message);
            }
        });

        async function cargarModalEditar (idCamiseta, estadoCamiseta) {
            if (estadoCamiseta != "Disponible") {
                 Swal.fire({
                    icon: 'warning',
                    title: 'Advertencia',
                    text: `La camiseta se encuentra ${estadoCamiseta}, por lo tanto no es posible realizarle modificaciones.`,
                 });

                 return;
            }
                
            const response = await fetch(`/Camiseta/CamisetaEdit?id=${idCamiseta}`);
            const contenedor = document.getElementById('contenedorModalEditar');

            //Renderiza la vista parcial en el contenedor auxiliar.
            contenedor.innerHTML = await response.text();

            //Formulario del modal, una vez renderizado.
            const form = contenedor.querySelector('form');

            //Obtención de datos de la camiseta almacenados en estructuras.
            const datosEdicion = {
                equipo: JSON.parse(form.querySelector('#equipoJSON').value),
                jugador: JSON.parse(form.querySelector('#jugadorJSON').value),
                temporada: form.querySelector('#temporadaAux').value,
                imagenes: JSON.parse(form.querySelector('#imagenesJSON').value)
            };

            inicializarControles('editarCamisetaForm', datosEdicion);

            //Abre el modal ya renderizado.
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();

            //Evento submit del formulario de edición de camisetas.
            document.getElementById("editarCamisetaForm").addEventListener("submit", async function (e) {
                try {
                    e.preventDefault();

                    //Valida que todos los campos cumplan con las especificaciones necesarias.
                    if (!$("#editarCamisetaForm").valid())
                        return;

                    const form = this;
                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData
                    });

                    const responseJson = await response.json();

                    switch (responseJson.statusCode)
                    {
                        case "sucess":
                            Swal.fire({
                                icon: 'success',
                                title: 'Camiseta modificada',
                                text: responseJson.message,
                            }).then(() => {
                                //Recarga el listado al finalizar la ejecucción.
                                location.reload();
                            });

                            break;
                        case "warning":
                            Swal.fire({
                                icon: 'warning',
                                title: 'Advertencia',
                                html: responseJson.message,
                            });

                            break;

                        case "error":
                            Swal.fire({
                                icon: 'error',
                                title: 'Error al editar la camiseta',
                                text: responseJson.message,
                            });

                            break;
                    }
                }
                catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error al editar la camiseta',
                        text: 'Ha ocurrido un error al intentar editar la camiseta. Por favor intente nuevamente o contacte a soporte del sistema.'
                    });

                    console.log(error.message);
                }
            });
        }

        function ChangeState(event, accion, nombre, btn, estadoCamiseta) {
                    event.preventDefault();

                    if (estadoCamiseta != "Disponible") {
                         Swal.fire({
                            icon: 'warning',
                            title: 'Advertencia',
                            text: `La camiseta se encuentra ${estadoCamiseta}, por lo tanto no es posible realizarle modificaciones.`,
                         });

                         return;
                    }

                    Swal.fire({
                        title: accion.charAt(0).toUpperCase() + accion.slice(1) + ' usuario?',
                        text: 'Se va a ' + accion + ' a: ' + nombre,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, continuar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: accion === 'deshabilitar' ? '#dc3545' : '#198754'
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            // Buscamos el formulario de manera más segura
                            var form = btn.parentElement;
                            if (form && form.tagName === 'FORM') {
                                form.submit();
                            } else {
                                // Si el parent no es el form, lo buscamos hacia arriba
                                btn.closest('form').submit();
                            }
                        }
                    });
                }
        
       
    </script>

    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
