@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>
@{
    ViewData["Title"] = "Mis Subastas";
    var total = Model?.Count() ?? 0;
    var activas = Model?.Count(s => s.FechaCompra == null && s.FechaCierre > DateTime.Now) ?? 0;
    var vendidas = Model?.Count(s => s.FechaCompra != null) ?? 0;
    var finalizadas = total - activas - vendidas;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-person-circle text-primary me-2"></i>Mis Subastas
        </h1>
        <p class="text-muted mb-0">Resumen de tus subastas como vendedor.</p>
    </div>
</div>

<!-- Resumen rápido -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="card border-0 bg-primary bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-primary">@activas</div>
            <div class="small text-muted">Activas</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card border-0 bg-success bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-success">@vendidas</div>
            <div class="small text-muted">Vendidas</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card border-0 bg-secondary bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-secondary">@finalizadas</div>
            <div class="small text-muted">Finalizadas</div>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>No tienes subastas registradas.</div>
    </div>
}
else
{
    <section aria-label="Mis subastas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation?.ImagenCamiseta?.FirstOrDefault();
                var esActiva = item.FechaCompra == null && item.FechaCierre > DateTime.Now;
                var fueVendida = item.FechaCompra != null;
                var estadoBadge = esActiva ? "primary" : fueVendida ? "success" : "secondary";
                var estadoTexto = esActiva ? "Activa" : fueVendida ? "Vendida" : "Finalizada";
                var estadoIcono = esActiva ? "bi-hammer" : fueVendida ? "bi-check-circle" : "bi-x-circle";
                var tiempoRestante = item.FechaCierre - DateTime.Now;
                var urgencia = tiempoRestante.TotalHours < 2 ? "danger"
                : tiempoRestante.TotalHours < 24 ? "warning"
                : "success";

                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <!-- Imagen con badge -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height: 240px;">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="Imagen de @item.IdCamisetaNavigation.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Sin imagen</span>
                                </div>
                            }
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-@estadoBadge">
                                <i class="bi @estadoIcono me-1"></i>@estadoTexto
                            </span>
                        </div>
                    </div>

                    <!-- Contenido -->
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-2 text-truncate"
                            title="@item.IdCamisetaNavigation?.Nombre">
                            @item.IdCamisetaNavigation?.Nombre
                        </h2>

                        <!-- Precio y pujas -->
                        <div class="d-flex gap-2 mb-2">
                            <span class="badge rounded-pill bg-primary px-3 py-2">
                                <i class="bi bi-cash me-1"></i>
                                @(item.Puja.Any()
                                                            ? item.Puja.Max(p => p.Monto).ToString("C")
                                                            : item.PrecioBase.ToString("C"))
                        </span>
                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                            <i class="bi bi-people me-1"></i>
                            @item.Puja.Count pujas
                        </span>
                    </div>

                            <!-- Tiempo restante si está activa -->
                    @if (esActiva)
                            {
                                <div class="d-flex align-items-center gap-2 small">
                                    <i class="bi bi-clock text-@urgencia"></i>
                                    <span class="text-@urgencia fw-semibold">
                                        @if (tiempoRestante.TotalHours < 1)
                                        {
                                            @($"Cierra en {(int)tiempoRestante.TotalMinutes} min")
                                        }
                                        else if (tiempoRestante.TotalHours < 24)
                                        {
                                            @($"Cierra en {(int)tiempoRestante.TotalHours} h")
                                        }
                                        else
                                        {
                                            @($"Cierra el {item.FechaCierre:d/M/yy HH:mm}")
                                        }
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <i class="bi bi-calendar-x"></i>
                                    <span>Cerró: @item.FechaCierre.ToString("d/M/yy HH:mm")</span>
                                </div>
                            }
                        </div>

                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3 px-3">
                            <a asp-controller="Subasta"
                               asp-action="Details"
                               asp-route-id="@item.IdSubasta"
                               class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye me-1"></i> Ver detalle
                            </a>
                        </div>

                    </article>
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <style>
        .card:hover { transform: translateY(-3px); transition: transform .18s ease; }
        .badge.rounded-pill { font-size: 0.8rem; }
    </style>
}
