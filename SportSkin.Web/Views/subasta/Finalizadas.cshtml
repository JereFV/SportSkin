@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>
@{
    ViewData["Title"] = "Subastas Finalizadas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-check-circle text-secondary me-2"></i>Subastas Finalizadas
        </h1>
        <p class="text-muted mb-0">Subastas cerradas. Total: <strong>@total</strong>.</p>
    </div>

    <!-- Filtro por fechas -->
    <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small text-muted mb-1">Desde</label>
            <input type="date" name="desde" value="@ViewBag.Desde"
                   class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small text-muted mb-1">Hasta</label>
            <input type="date" name="hasta" value="@ViewBag.Hasta"
                   class="form-control form-control-sm" />
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">
            <i class="bi bi-search me-1"></i> Filtrar
        </button>
        @if (ViewBag.Desde != null || ViewBag.Hasta != null)
        {
            <a asp-action="Finalizadas" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i> Limpiar
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>No hay subastas finalizadas.</div>
    </div>
}
else
{
    <section aria-label="Subastas finalizadas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation?.ImagenesCamiseta?.FirstOrDefault();
                var fueVendida = item.FechaCompra != null;

                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <!-- Imagen con badge de resultado -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height: 240px;">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="Imagen de @item.IdCamisetaNavigation.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Sin imagen</span>
                                </div>
                            }

                            <!-- Badge resultado sobre la imagen -->
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (fueVendida)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Vendida
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i> Sin comprador
                                    </span>
                                }
                        </div>
                    </div>

                    <!-- Contenido -->
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-2 text-truncate"
                            title="@item.IdCamisetaNavigation?.Nombre">
                            @item.IdCamisetaNavigation?.Nombre
                        </h2>

                        <!-- Precio final y pujas -->
                        <div class="d-flex gap-2 mb-2">
                            <span class="badge rounded-pill bg-secondary px-3 py-2">
                                <i class="bi bi-cash me-1"></i>
                                @(item.Puja.Any()
                                                            ? item.Puja.Max(p => p.Monto).ToString("C")
                                                            : item.PrecioBase.ToString("C"))
                        </span>
                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                            <i class="bi bi-people me-1"></i>
                            @item.Puja.Count pujas
                        </span>
                    </div>

                            <!-- Fecha cierre -->
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="bi bi-calendar-x"></i>
                                <span>Cerró: @item.FechaCierre.ToString("d/M/yy HH:mm")</span>
                            </div>

                            <!-- Fecha compra si aplica -->
                    @if (fueVendida)
                            {
                                <div class="d-flex align-items-center gap-2 text-success small mt-1">
                                    <i class="bi bi-bag-check"></i>
                                    <span>Comprada: @item.FechaCompra?.ToString("d/M/yy HH:mm")</span>
                                </div>
                            }
                        </div>

                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3 px-3">
                            <a asp-controller="Subasta"
                               asp-action="Details"
                               asp-route-id="@item.IdSubasta"
                               class="btn btn-outline-secondary w-100">
                                <i class="bi bi-eye me-1"></i> Ver detalle
                            </a>
                        </div>

                    </article>
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
