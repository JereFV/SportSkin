@using Newtonsoft.Json.Linq
@using System.Security.Claims

@{
    string rol = User.FindFirst(ClaimTypes.Role)?.Value ?? "Invitado";
    int idUsuario = int.Parse(@User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0");
}

<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
    <div class="container-fluid px-1">
        <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="HomeIndex">
            <img src="~/images/SportSkinLogo.png"
                 alt="SportSkin Logo"
                 height="56"
                 class="me-2"
                 style="object-fit: contain;">
            <span>SportSkin</span>
        </a>

        <div class="collapse navbar-collapse" id="navbarColor01">
            <ul class="navbar-nav me-auto">

                @* Inicio — todos *@
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="HomeIndex"
                       data-i18n="nav.home"> </a>
                </li>

                @* Camisetas — Vendedor *@
                @if (rol == "Vendedor")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Camiseta" asp-route-idUsuario="@idUsuario" asp-action="CamisetaIndex"
                           data-i18n="nav.shirts"></a>
                    </li>
                }

                @* Subastas — Visible por todos los roles e invitados. *@
                <li class="nav-item d-flex align-items-center dropdown">
                    <a class="nav-link pe-1"
                       asp-controller="Subasta" asp-action="SubastaIndex"
                       data-i18n="nav.auctions"></a>
                    <a class="nav-link ps-0 pe-2 dropdown-toggle dropdown-toggle-split"
                       data-bs-toggle="dropdown" aria-expanded="false" href="#">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" asp-controller="Subasta" asp-action="Activas">
                                <i class="fa-solid fa-gavel me-1"></i>
                                <span data-i18n="nav.activeAuctions"></span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Subasta" asp-action="Finalizadas">
                                <i class="bi bi-check-circle me-1"></i>
                                <span data-i18n="nav.finishedAuctions"></span>
                            </a>
                        </li>
                        @if (rol == "Vendedor")
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Subasta" asp-action="MisSubastas">
                                    <i class="bi bi-person me-1"></i>
                                    <span data-i18n="nav.myAuctions"> </span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                @* Usuarios — solo Admin *@
                @if (rol == "Administrador")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Usuario" asp-action="UsuarioIndex"
                           data-i18n="nav.users"></a>
                    </li>
                }

                @* Pagos — solo Comprador *@
                @if (rol == "Comprador")
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Pago" asp-action="PagoIndex">
                            <span data-i18n="nav.payments"> </span>
                        </a>
                    </li>
                }

                @* Reportes — solo Admin *@
                @if (rol == "Administrador")
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span data-i18n="nav.reports"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="ReporteParticipacionCompradores">
                                    <i class="bi bi-people me-1"></i> Participación de Compradores
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Reporte" asp-action="ReporteActividadSistema">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Actividad del sistema
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>

            <ul class="navbar-nav ms-auto">
                @* Selector de idioma *@
                @await Html.PartialAsync("_LanguageSelector")

                @* Usuario en sesión *@
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(User?.Identity?.IsAuthenticated == true ? "dropdown-toggle" : "")"
                       data-bs-toggle="@(User?.Identity?.IsAuthenticated == true ? "dropdown" : "modal")" data-bs-target="#modalLogin"
                       href="#" role="button" aria-haspopup="true" aria-expanded="false">
                        <i class="bi bi-person-circle"></i>
                        <span>@(User?.Identity?.Name ?? "Invitado")</span>
                    </a>

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown-menu dropdown-menu-end">
                            <span class="dropdown-item-text text-muted small">@(rol)</span>
                            <div class="dropdown-divider"></div>

                            <a class="dropdown-item" id="btnMiPerfil">Mi Perfil</a>

                            <a class="dropdown-item" href="#" data-i18n="nav.changePassword" id="btnCambiarClave"
                               data-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
                               data-nombre="@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value"></a>

                            @* Mi Historial — Comprador y Vendedor *@
                            @if (rol == "Comprador" || rol == "Vendedor")
                            {
                                <a class="dropdown-item" href="#"
                                   data-bs-toggle="modal" data-bs-target="#modalMiHistorial">Mi Historial
                                </a>
                            }

                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-controller="Login" asp-action="LogOut"
                               data-i18n="nav.logout" id="btnLogout"></a>
                        </div>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    document.getElementById("btnLogout")?.addEventListener("click", async function () {
        sessionStorage.setItem("mensajeCambioSesion", JSON.stringify({
            icon: "success",
            title: "La sesión ha sido cerrada satisfactoriamente."
        }));
    });

    document.getElementById("btnMiPerfil")?.addEventListener("click", async function (e) {
        e.preventDefault();

        const response = await fetch("/Usuario/GetPerfilUsuario");
        const data = await response.json();

        document.getElementById("editIdUsuario").value      = data.idUsuario;
        document.getElementById("editNombre").value         = data.nombre;
        document.getElementById("editApellido1").value      = data.apellido1;
        document.getElementById("editApellido2").value      = data.apellido2;
        document.getElementById("editCorreo").value         = data.correo;
        document.getElementById("editTelefono").value       = data.telefono;
        document.getElementById("editRol").value            = data.rol;
        document.getElementById("editFechaCreacion").value  = data.fechaCreacion;
        document.getElementById("esVistaPerfil").value = "true";
        document.getElementById("labelEditarUsuario").innerText = "Mi Perfil";

        const iconoLabel = document.getElementById("iconoLabelEditarUsuario");
        iconoLabel.classList.remove("fa-pen-to-square");
        iconoLabel.classList.add("fa-user");

        new bootstrap.Modal(document.getElementById("modalEditarUsuario")).show();
    });

    document.getElementById("btnCambiarClave")?.addEventListener("click", async function (e) {
        document.getElementById('passIdUsuario').value = this.dataset.id;
        document.getElementById('passNombreUsuario').textContent = this.dataset.nombre;
        document.getElementById('passNueva').value = '';
        document.getElementById('passConfirmar').value = '';
        document.getElementById('errPassNueva').textContent = '';
        document.getElementById('errPassConfirmar').textContent = '';
        document.getElementById('esOpcionNav').value = "true";

        new bootstrap.Modal(document.getElementById('modalCambiarContrasena')).show();
    });
</script>
