@model SportSkin.Web.ViewModels.CreacionCamisetaViewModel

<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    <i class="fa-solid fa-circle-plus text-primary"></i>
                     &nbspNueva Camiseta
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label for="nombre" class="form-label fw-semibold">Nombre</label>
                            <input type="text" class="form-control" id="nombre">
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label fw-semibold">Descripción</label>
                            <textarea class="form-control no-resize" id="descripcion" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="estado" class="form-label fw-semibold">Estado</label>
                            <input type="text" class="form-control" id="estado" value="Activo" disabled>
                        </div>

                        <div class="mb-3">
                            <label for="vendedor" class="form-label fw-semibold">Vendedor</label>
                            <input type="text" class="form-control" id="vendedor" value="@Model.NombreCompletoVendedor" disabled>
                        </div>

                        <div class="mb-3" style="display: flex; flex-direction: column">
                            <label for="categorias" class="form-label fw-semibold">Categorias</label>
                            <select class="form-select" multiple id="categorias">
                                @if (Model.CategoriasCamiseta != null)
                                {
                                    @foreach (SportSkin.Application.DTOs.CategoriaCamisetaDTO categoria in Model.CategoriasCamiseta)
                                    {
                                        <option value="@categoria.IdCategoriaCamiseta">@categoria.Nombre</option>
                                    }
                                }                                                       
                            </select>
                        </div>

                        <div class="mb-3" style="display: flex; flex-direction: column">
                            <label for="condicion" class="form-label fw-semibold">Condición</label>
                            <select class="form-select" id="condicion">
                                <option hidden>Seleccione la condición</option>
                                @if (Model.CondicionesCamiseta != null)
                                {
                                    @foreach (SportSkin.Application.DTOs.CondicionCamisetaDTO condicion in Model.CondicionesCamiseta)
                                    {
                                        <option value="@condicion.IdCondicionCamiseta">@condicion.Nombre</option>
                                    }
                                }
                            </select>
                        </div>                   
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-success">Guardar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

