@model IEnumerable<SportSkin.Web.ViewModels.ListadoUsuariosViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<h3>
    <i class="fa-solid fa-users text-primary"></i>
    &nbsp;<span data-i18n="users:listTitle">  </span>
</h3>

<br />

@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<table class="table" id="usersList">
    <thead>
        <tr>
            <th>
                <span data-i18n="users:fields.fullName"> </span>:
            </th>
            <th>
                <span data-i18n="users:fields.role"> </span>:
            </th>
            <th>
                <span data-i18n="users:fields.status"> </span>:
            </th>
            <th>
                <span data-i18n="users:actions">Acciones</span>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? Enumerable.Empty<SportSkin.Web.ViewModels.ListadoUsuariosViewModel>())
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreCompleto)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rol)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>
                <td class="col-md-6">
                    <div>
                        <a asp-controller="Usuario"
                           asp-action="UsuarioDetails"
                           asp-route-id="@item.IdUsuario"
                           class="btn btn-outline-info userstable-action-buttons">
                            <i class="fa-solid fa-circle-info"></i>&nbsp;<span data-i18n="actions.details"> </span>
                        </a>

                        <button type="button" class="btn btn-outline-primary userstable-action-buttons">
                            <i class="fa-regular fa-pen-to-square"></i>&nbsp;<span data-i18n="actions.edit"></span>
                        </button>

                        <button type="button" class="btn btn-outline-dark userstable-action-buttons">
                            <i class="fa-solid fa-key"></i>&nbsp;<span data-i18n="nav.changePassword"> </span>
                        </button>

                        @if (item.Estado == "Activo")
                        {
                            <button type="button" class="btn btn-outline-danger userstable-status-actions">
                                <i class="fa-solid fa-ban"></i>&nbsp;<span data-i18n="actions.disable"></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-success userstable-status-actions">
                                <i class="fa-solid fa-circle-check"></i>&nbsp;<span data-i18n="actions.enable"></span>
                            </button>
                        }

                        <div class="userstable-status-btngroup">
                        </div>

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>

        $(document).ready(function () {
            //Inicialización del listado utilizando datatables.
            $('#usersList').DataTable({
                "columnDefs": [
                    { "className": "dt-center", "targets": [0, 1, 2, 3] }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json"
                }
            });
        });
    </script>
}


