@model SportSkin.Application.DTOs.UsuarioDTO
@{
    ViewData["Title"] = "Detalle Usuario";
    var nombreCompleto = $"{Model.Nombre} {Model.Apellido1} {Model.Apellido2}".Trim();
    var cantidadSubastas = Model.Subasta.Count;
    var cantidadPujas = Model.Puja.Count;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">

            <!-- Header con avatar y nombre -->
            <div class="card-body text-center pt-4 pb-2">
                <div class="mb-3">
                    <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                </div>
                <h1 class="h4 fw-semibold mb-2">@nombreCompleto</h1>

                <!-- Badges de Rol y Estado -->
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge rounded-pill bg-primary px-3 py-2">
                        @Model.RolUsuarioNavigation?.Nombre
                    </span>
                    <span class="badge rounded-pill px-3 py-2
                        @(Model.Estado ? "bg-success" : "bg-danger")">
                        @(Model.Estado
                                                ? Html.Raw($"<span data-i18n=\"status.active\">Activo</span>")
                                                : Html.Raw($"<span data-i18n=\"status.inactive\">Inactivo</span>"))
                    </span>
                </div>
            </div>

            <hr class="mx-3 my-0" />

            <!-- Info general -->
            <div class="card-body">

                <!-- Fecha de registro -->
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-primary" style="width: 2rem; text-align:center;">
                        <i class="bi bi-calendar3 fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted" data-i18n="users:fields.registrationDate">  </div>
                        <div class="fw-semibold">@Model.FechaCreacion.ToString("d/M/yyyy")</div>
                    </div>
                </div>

                <!-- Correo -->
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-primary" style="width: 2rem; text-align:center;">
                        <i class="bi bi-envelope fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted" data-i18n="users:fields.email"></div>
                        <div class="fw-semibold">@Model.Correo</div>
                    </div>
                </div>

                <!-- Teléfono -->
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="text-primary" style="width: 2rem; text-align:center;">
                        <i class="bi bi-telephone fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted" data-i18n="users:fields.phone"></div>
                        <div class="fw-semibold">@Model.Telefono</div>
                    </div>
                </div>

                <hr />

                @if (Model.IdRolUsuario == 2)
                {
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-body-tertiary mb-2">
                        <span class="text-muted small" data-i18n="users:sellerStats.createdAuctions"></span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-primary fs-5">@ViewBag.TotalSubastas</span>
                            <span class="badge bg-primary small" data-i18n="badges.seller"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 px-2">
                        <span class="badge bg-success">@ViewBag.SubastasVendidas <span data-i18n="users:sellerStats.soldBadge" data-i18n-options='{"count":@ViewBag.SubastasVendidas}'>@(ViewBag.SubastasVendidas != 1 ? "vendidas" : "vendida")</span></span>
                        <span class="badge bg-primary">@ViewBag.SubastasActivas <span data-i18n="users:sellerStats.activeBadge" data-i18n-options='{"count":@ViewBag.SubastasActivas}'>@(ViewBag.SubastasActivas != 1 ? "activas" : "activa")</span></span>
                        <span class="badge bg-secondary">@ViewBag.SubastasFinalizadas <span data-i18n="users:sellerStats.finishedBadge" data-i18n-options='{"count":@ViewBag.SubastasFinalizadas}'>@(ViewBag.SubastasFinalizadas != 1 ? "finalizadas" : "finalizada")</span></span>
                    </div>
                }
                else if (Model.IdRolUsuario == 3) // Comprador
                {
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-body-tertiary">
                        <span class="text-muted small" data-i18n="users:buyerStats.bidsCount"></span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold text-primary fs-5">@Model.Puja.Count</span>
                            <span class="badge bg-success small" data-i18n="badges.buyer"></span>
                        </div>
                    </div>
                }
                else // Administrador u otro rol
                {
                    <div class="p-2 rounded bg-body-tertiary text-muted small text-center">
                        <i class="bi bi-shield-check me-1"></i>
                        <span data-i18n="users:adminNote"></span>
                    </div>
                }
            </div>

            <!-- Footer con botón volver -->
            <div class="card-footer bg-body border-0 pb-3 px-3">
                <a asp-action="UsuarioIndex" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-left me-1"></i> <span data-i18n="actions.back"></span>
                </a>
            </div>

        </div>
    </div>
</div>
