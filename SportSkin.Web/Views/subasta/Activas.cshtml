@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>

@{
    ViewData["Title"] = "Subastas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">
            <span data-i18n="auctions:activeAuctions"></span>
        </h1>
        <p class="text-muted mb-0">
            <span data-i18n="auctions:totalLabel"></span> <strong>@total</strong>.
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-md">
            <button type="button" class="btn btn-outline-success btn-sm" style="border-radius:12px">
                <i class="bi bi-plus-circle"></i>
                <span data-i18n="actions.addAuction"></span>
            </button>
        </div>
    </div>

    <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small text-muted mb-1" data-i18n="filters.from"></label>
            <input type="date" id="inputDesde" name="desde" value="@ViewBag.Desde"
                   class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small text-muted mb-1" data-i18n="filters.until"></label>
            <input type="date" id="inputHasta" name="hasta" value="@ViewBag.Hasta"
                   class="form-control form-control-sm" />
        </div>
        <button type="submit" id="btnFiltrar" class="btn btn-secondary btn-sm">
            <i class="bi bi-search me-1"></i><span data-i18n="actions.filter"></span>
        </button>
        @if (ViewBag.Desde != null || ViewBag.Hasta != null)
        {
            <a asp-action="Activas" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i><span data-i18n="actions.clear"></span>
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div data-i18n="auctions:noActive"></div>
    </div>
}
else
{
    <section aria-label="Listado de camisetas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation?.ImagenesCamiseta?.FirstOrDefault();
                var estadoId = item.IdEstadoSubasta;
                var estadoNombre = item.IdEstadoSubastaNavigation?.Nombre ?? "—";
                var (estadoColor, estadoIcono) = estadoId switch
                {
                    1 => ("success",   "bi bi-lightning-charge"), // Activa
                    6 => ("primary",   "bi bi-broadcast"),        // Publicada
                    _ => ("dark",      "bi bi-question-circle")
                };
                var tiempoRestante = item.FechaCierre - DateTime.Now;
                var urgencia = tiempoRestante.TotalHours < 2  ? "danger"
                             : tiempoRestante.TotalHours < 24 ? "warning"
                             : "success";
                var precioFinal = item.Puja.Any()
                    ? item.Puja.Max(p => p.Monto).ToString("C")
                    : item.PrecioBase.ToString("C");

                <div class="col">
                    <a asp-action="Subasta" asp-route-id="@item.IdSubasta" style="text-decoration: none">
                        <article class="card h-100 shadow-sm border-0">
                            <!-- Imagen -->
                            <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height: 240px;">
                                @if (primeraImagen != null)
                                {
                                    <img class="w-100 h-100 object-fit-cover rounded-top"
                                         src="@primeraImagen.RutaImagen"
                                         alt="@item.IdCamisetaNavigation?.Nombre"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                        <i class="bi bi-image fs-1"></i>
                                        <span class="small">Foto/Fotos</span>
                                    </div>
                                }                            
                            </div>

                            <!-- Contenido -->
                            <div class="card-body">
                                <h2 class="h6 fw-semibold mb-2 text-truncate"
                                    title="@item.IdCamisetaNavigation?.Nombre">
                                    @item.IdCamisetaNavigation?.Nombre
                                </h2>

                                    <!-- Card activa: precio actual + pujas + tiempo restante -->
                                    <div class="d-flex gap-2 mb-2">
                                        <span class="badge rounded-pill bg-primary px-3 py-2">
                                            <i class="bi bi-cash me-1"></i>@precioFinal
                                        </span>
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            <i class="bi bi-people me-1"></i><span data-i18n="auctions:bids.count" data-i18n-options='{"count":@item.Puja.Count}'>@(item.Puja.Count == 1 ? "puja" : "pujas")</span>
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 small">
                                        <i class="bi bi-clock text-@urgencia"></i>
                                        <span class="text-@urgencia fw-semibold">
                                            @if (tiempoRestante.TotalHours < 1)
                                            {
                                                <span data-i18n="auctions:time.closesIn">Cierra en</span> @((int)tiempoRestante.TotalMinutes) <span data-i18n="auctions:time.min" data-i18n-options='{"count":@((int)tiempoRestante.TotalMinutes)}'>@((int)tiempoRestante.TotalMinutes != 1 ? "minutos" : "minuto")</span>
                                            }
                                            else if (tiempoRestante.TotalHours < 24)
                                            {
                                                <span data-i18n="auctions:time.closesIn">Cierra en</span> @((int)tiempoRestante.TotalHours) <span data-i18n="auctions:time.hours" data-i18n-options='{"count":@((int)tiempoRestante.TotalHours)}'>@((int)tiempoRestante.TotalHours != 1 ? "horas" : "hora")</span>
                                            }
                                            else
                                            {
                                                @($"Cierra el {item.FechaCierre:d/M/yy HH:mm}")
                                            }
                                        </span>
                                    </div>
                            </div>                    
                        </article>
                    </a>                  
                </div>
            }

        </div>
    </section>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputDesde= document.getElementById('inputDesde');
            const inputHasta = document.getElementById('inputHasta');
            const btnFiltrar = document.getElementById('btnFiltrar');


            function verificarBoton() {
                if (inputDesde.value && !inputHasta.value || !inputDesde.value && inputHasta.value) {
                    btnFiltrar.disabled = true;
                    btnFiltrar.title = "Debes ingresar la fecha hasta";
                } else {
                    btnFiltrar.disabled = false;
                    btnFiltrar.title = "";
                }
            }

            inputDesde.addEventListener('change',function(){
                if(!this.value) return;
                const desde = new Date(this.value);

                //calcular máximo (1 mes después)
                const maxHasta = new Date(desde);
                maxHasta.setMonth(desde.getMonth()+1);
                // Cuando cambia "desde", el mínimo de "hasta" se actualiza
                inputHasta.min= this.value;
                inputHasta.max = maxHasta.toISOString().split('T')[0];
                //Si hasta ya tenía una fecha la limpia
                if(inputHasta.value && inputHasta< this.value){
                    inputHasta.value='';
                }
                verificarBoton();
            });

            inputHasta.addEventListener('change', function () {
                // Cuando cambia "hasta", el máximo de "desde" se actualiza
                inputDesde.max = this.value;
                verificarBoton();
            });
        });
    </script>
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
