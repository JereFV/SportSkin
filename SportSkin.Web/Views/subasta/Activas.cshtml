@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>

@{
    ViewData["Title"] = "Subastas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Subastas de camisetas</h1>
        <p class="text-muted mb-0">Explora el catálogo disponible. Total: <strong>@total</strong>.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-md">
            <button type="button" class="btn btn-outline-success btn-sm" style="border-radius:12px">
                <i class="bi bi-plus-circle"></i>
                Agregar subasta
            </button>
        </div>
    </div>

    <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small text-muted mb-1">Desde</label>
            <input type="date" id="inputDesde" name="desde" value="@ViewBag.Desde"
                   class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small text-muted mb-1">Hasta</label>
            <input type="date" id="inputHasta" name="hasta" value="@ViewBag.Hasta"
                   class="form-control form-control-sm" />
        </div>
        <button type="submit" id="btnFiltrar"class="btn btn-secondary btn-sm">
            <i class="bi bi-search me-1"></i> Filtrar
        </button>
        @if (ViewBag.Desde != null || ViewBag.Hasta != null)
        {
            <a asp-action="Activas" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i> Limpiar
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>No hay camisetas disponibles en este momento.</div>
    </div>
}
else
{
    <section aria-label="Listado de camisetas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation.ImagenesCamiseta?.FirstOrDefault();
                <div class="col">
                    <article class="card h-100 shadow-sm border-0">
                        <!-- Imagen -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary" style="height: 320px; border-radius:16px">
                            @* Si hay imagen, la mostramos; si no, placeholder *@
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover  rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="Imagen de @item.IdCamisetaNavigation.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Sin imagen</span>
                                </div>
                            }
                    </div>

                    <!-- Contenido -->
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-1 text-truncate" title="@item.IdCamisetaNavigation.Nombre">
                            @item.IdCamisetaNavigation.Nombre
                        </h2>

                        <!-- Precio y Cantidad de pujas-->
                        <div class="d-flex gap-2 mb-0">
                            <span class="badge rounded-pill bg-primary px-3 py-2">
                                @(item.Puja.Any()?item.Puja.Max(p=> p.Monto).ToString("C"):item.PrecioBase.ToString("C"))
                            </span>
                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                    <i class="bi bi-people me-1"></i>
                                @item.Puja.Count pujas
                            </span>
                            
                        </div>

                        <div class="d-flex align-items-center gap-2 text-muted small">
                             <i class="bi bi-clock text-primary"></i>
                             <span>Fecha de cierre: @item.FechaCierre.ToString("d/M/yy HH:mm")</span>
                         </div>
                    </div>

                    <!-- Acciones -->
                    <div class="card-footer bg-body border-0 pt-0 pb-2">
                        <div class="d-flex gap-2 px-2">                            
                            <a asp-controller="Camiseta"
                               asp-action="Details"
                               asp-route-id="@item.IdCamiseta"
                               class="btn btn-info flex-fill">
                                    <i class="bi bi-eye me-1"></i> Ver detalle
                            </a>

                        </div>
                    </div>
                </article>
            </div>
                }

        </div>
    </section>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputDesde= document.getElementById('inputDesde');
            const inputHasta = document.getElementById('inputHasta');
            const btnFiltrar = document.getElementById('btnFiltrar');


            function verificarBoton() {
                if (inputDesde.value && !inputHasta.value || !inputDesde.value && inputHasta.value) {
                    btnFiltrar.disabled = true;
                    btnFiltrar.title = "Debes ingresar la fecha hasta";
                } else {
                    btnFiltrar.disabled = false;
                    btnFiltrar.title = "";
                }
            }

            inputDesde.addEventListener('change',function(){
                if(!this.value) return;
                const desde = new Date(this.value);

                //calcular máximo (1 mes después)
                const maxHasta = new Date(desde);
                maxHasta.setMonth(desde.getMonth()+1);
                // Cuando cambia "desde", el mínimo de "hasta" se actualiza
                inputHasta.min= this.value;
                inputHasta.max = maxHasta.toISOString().split('T')[0];
                //Si hasta ya tenía una fecha la limpia
                if(inputHasta.value && inputHasta< this.value){
                    inputHasta.value='';
                }
                verificarBoton();
            });

            inputHasta.addEventListener('change', function () {
                // Cuando cambia "hasta", el máximo de "desde" se actualiza
                inputDesde.max = this.value;
                verificarBoton();
            });
        });
    </script>
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
