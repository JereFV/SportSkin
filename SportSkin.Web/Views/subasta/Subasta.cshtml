@using System.Security.Claims
@model SportSkin.Web.ViewModels.InterfazSubastaViewModel

@{
    ViewData["Title"] = "Subasta - " + Model.Subasta.IdCamisetaNavigation?.Nombre;
}

<div class="row mb-3">
    <a class="icon-link icon-link-hover link-info" asp-action="SubastaIndex">
        <svg xmlns="http://www.w3.org/2000/svg" class="bi" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
        </svg>
        Regresar al listado
    </a>
</div>

<div class="auction-wrapper">
    @*Imágenes de la camiseta.*@
    <div class="auction-carousel-wrap">
        <partial name="_ImagesCarrousel" model="Model.Subasta?.IdCamisetaNavigation?.ImagenesCamiseta" />
    </div>

    @*Detalle de camiseta y subasta.*@
    <div>
        @* Card Camiseta*@
        <div class="a-card">
            <div class="object-title">@Model.Subasta?.IdCamisetaNavigation?.Nombre</div>

            @* Categorías *@
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var cat in Model.Subasta?.IdCamisetaNavigation?.CategoriasCamiseta ?? Enumerable.Empty<SportSkin.Application.DTOs.CategoriaCamisetaDTO>())
                {
                    <span class="badge text-bg-primary">
                        <i class="fa-solid fa-tag" style="font-size:.65rem"></i> @cat.Nombre
                    </span>
                }
                <span class="badge @(Model.Subasta?.IdCamisetaNavigation?.Autografiada == true ? "text-bg-success" : "text-bg-warning")">
                    <i class="fa-solid fa-signature" style="font-size:.65rem"></i> @Html.DisplayFor(model => model.SituacionFirma)
                </span>
            </div>

            @* Datos específicos de la camiseta. *@
            <div class="shirt-attrs">
                <div class="shirt-attr-item">
                    <i class="fa-solid fa-magnifying-glass shirt-attr-icon"></i>
                    <div>
                        <div class="shirt-attr-label">Condición</div>
                        <div class="shirt-attr-value">@Html.DisplayFor(model => model.Subasta.IdCamisetaNavigation.CondicionCamisetaNavigation.Nombre)</div>
                    </div>
                </div>
                <div class="shirt-attr-item">
                    <i class="fa-solid fa-futbol shirt-attr-icon"></i>
                    <div>
                        <div class="shirt-attr-label">Equipo</div>
                        <div class="shirt-attr-value">@Html.DisplayFor(model => model.Subasta.IdCamisetaNavigation.EquipoNavigation.Nombre)</div>
                    </div>
                </div>
                <div class="shirt-attr-item">
                    <i class="fa-solid fa-person-running shirt-attr-icon"></i>
                    <div>
                        <div class="shirt-attr-label">Jugador</div>
                        <div class="shirt-attr-value">@Html.DisplayFor(model => model.NombreCompletoJugador)</div>
                    </div>
                </div>
                <div class="shirt-attr-item">
                    <i class="fa-solid fa-calendar-days shirt-attr-icon"></i>
                    <div>
                        <div class="shirt-attr-label">Temporada</div>
                        <div class="shirt-attr-value">@Html.DisplayFor(model => model.Subasta.IdCamisetaNavigation.Temporada)</div>
                    </div>
                </div>
            </div>

            <p class="object-desc">@Html.DisplayFor(model => model.Subasta.IdCamisetaNavigation.Descripcion)</p>

            @* Chip del vendedor *@
            <div style="font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--ss-muted); margin-bottom:.5rem;">
                Vendedor
            </div>
            <div class="seller-chip">
                <div class="seller-avatar bg-primary">@Model.InicialesVendedor</div>
                <div>
                    <div class="seller-name">@Html.DisplayFor(model => model.NombreCompletoVendedor)</div>
                    <div class="seller-email">@Html.DisplayFor(model => model.Subasta.IdCamisetaNavigation.UsuarioVendedorNavigation.Correo)</div>
                </div>
            </div>
        </div>

        @* Card Subasta *@
        <div class="a-card" id="seccionSubastas">        
            <div id="timerBlock"
                 class="timer-block"
                 data-close="@Model.Subasta?.FechaCierre.ToString("o")"> @*Fecha de cierre inyectada en formato ISO 8601 para su lectura desde JS.*@
                
                @*Título de estado — cambia dinámicamente via JS.*@
                <div class="timer-status-title" id="timerStatusTitle">
                    <i class="fa-solid fa-circle-dot" style="font-size:.6rem" id="timerStatusIcon"></i>
                    <span id="timerStatusText">Subasta en curso</span>
                </div>

                <hr class="timer-divider">

                @*Fila principal: ícono reloj + leyenda fija + dígitos con unidades inline.*@
                <div class="timer-main-row">
                    <i class="fa-regular fa-clock timer-clock-icon" id="timerIcon" style="color: var(--ss-warning)"></i>
                    <span class="timer-label">Tiempo restante</span>
                    <div class="timer-digits-group">
                        <span class="timer-num" id="timerH">--</span><span class="timer-unit-inline">h</span><span class="timer-colon">:</span><span class="timer-num" id="timerM">--</span><span class="timer-unit-inline">m</span><span class="timer-colon">:</span><span class="timer-num" id="timerS">--</span><span class="timer-unit-inline">s</span>
                    </div>
                </div>
            </div>

            @* Datos de la subasta *@
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-label">Precio base</div>
                    <div class="metric-value">@Html.DisplayFor(model => model.Subasta.PrecioBase)</div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Puja más alta</div>
                    <div class="metric-value metric-highlight" id="pujaActualDisplay">
                        @Html.DisplayFor(model => model.PujaActual)
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">Incremento mín.</div>
                    <div class="metric-value">@Html.DisplayFor(model => model.Subasta.IncrementoMinimo)</div>
                </div>
            </div>

            @* Historial de pujas *@
            <div class="bids-section-title" id="divTituloHistorialPujas">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                Historial de pujas
                @if (Model.Subasta?.Puja.Count > 0)
                {
                    <span class="badge text-bg-primary ms-1" id="cantidadPujas">@Model.CantidadTotalPujas</span>
                }
            </div>

            @if (Model.Subasta?.Puja.Count > 0)
            {
                <table class="bids-table" id="tablaHistorial">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Monto</th>
                            <th>Fecha y hora</th>
                        </tr>
                    </thead>
                    <tbody id="bodyHistorial">
                        @{
                            //Variable auxiliar para determinar si la puja a renderizar es la puja "líder".
                            bool esPrimera = true;
                        }
                        @foreach (var puja in Model.Subasta.Puja.OrderByDescending(x => x.Fecha))
                        {
                            <tr class="@(esPrimera ? "bid-leader" : "")">
                                <td>
                                    <div class="bid-user-cell">
                                        <div class="bid-avatar">
                                            @puja.IdUsuarioPujaNavigation?.Nombre.Substring(0, 1)@puja.IdUsuarioPujaNavigation?.Apellido1.Substring(0, 1)
                                        </div>
                                        <span class="bid-username"> @puja.IdUsuarioPujaNavigation?.Nombre @puja.IdUsuarioPujaNavigation?.Apellido1</span>
                                        @if (esPrimera)
                                        {
                                            <span class="badge text-bg-success" id="liderSubasta">
                                                <i class="fa-solid fa-trophy" style="font-size:.8rem"></i>
                                                @(Model.Subasta.IdEstadoSubasta == 2 || Model.Subasta.IdEstadoSubasta == 3 ? "Ganador" : "Líder")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="bid-amount @(esPrimera ? "leader-amount" : "")">
                                        @puja.Monto.ToString("C0", new System.Globalization.CultureInfo("en-US"))
                                    </span>
                                </td>
                                <td class="bid-date">@puja.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>

                            esPrimera = false;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-bids-msg" id="mensajeSinPujas">
                    @(Model.Subasta?.IdEstadoSubasta == 1 ? "Aún no hay pujas. ¡Sé el primero en hacerlo!" : "Subasta finalizada sin pujas.")
                </div>
            }
        </div>
    </div>
</div>

@* Botón de invocación al modal de Pujar.
   Habilitado únicamente para usuarios con el rol de Comprador.
*@
<button class="fab-pujar @(User.FindFirst(ClaimTypes.Role)?.Value != "Comprador" ? "fab-disabled" : "")"
        id="fabPujar"
        data-bs-toggle="modal" data-bs-target="#modalPujar"
        title="Pujar">
    <i class="fa-solid fa-gavel"></i>
    Pujar
</button>

@* MODAL DE PUJAS *@
<div class="modal fade" id="modalPujar" tabindex="-1" aria-labelledby="modalPujarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
        <div class="modal-content">
            <div class="modal-body p-4">

                <h5 class="fw-bold mb-1" id="modalPujarLabel">
                    <i class="fa-solid fa-gavel me-2"></i>
                    Realizar puja
                </h5>
                <p class="text-muted mb-3" style="font-size:.85rem">
                    @Model.Subasta?.IdCamisetaNavigation?.Nombre
                </p>

                @* Instrucción de monto mínimo permitido. *@
                <div class="modal-bid-hint">
                    <i class="fa-solid fa-circle-info mt-1" style="flex-shrink:0"></i>
                    <span>
                        Monto mínimo a pujar:
                        <strong id="montoMinimoDisplay">@Model.MontoMinProximaPuja.ToString("C0", new System.Globalization.CultureInfo("en-US"))</strong>                       
                    </span>
                </div>

                <div class="modal-amount-wrapper">
                    <div class="modal-currency-prefix">$</div>
                    <input type="number"
                           id="inputMonto"
                           placeholder="@Model.MontoMinProximaPuja"
                           min="@Model.MontoMinProximaPuja"
                           step="@Model.Subasta?.IncrementoMinimo" />
                </div>

                <span id="errorMontoText" class="text-danger"></span>              
                         
                <button class="btn btn-success w-100 mt-4" id="btnConfirmarPuja" disabled onclick="realizarPuja()">
                    Confirmar puja
                </button>

                <button type="button"
                        class="btn btn-secondary w-100 mt-2"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>         
        // Constantes de acceso a elementos del DOM.
        const timerBlock       = document.getElementById("timerBlock");
        const timerIcon        = document.getElementById("timerIcon");
        const timerStatusTitle = document.getElementById("timerStatusTitle");
        const timerStatusIcon  = document.getElementById("timerStatusIcon");
        const timerStatusText  = document.getElementById("timerStatusText");
        const horas              = document.getElementById("timerH");
        const minutos              = document.getElementById("timerM");
        const segundos              = document.getElementById("timerS");
        const botonPujar       = document.getElementById("fabPujar");
        const fechaCierre      = new Date(timerBlock.dataset.close);
        const inputMontoPuja = document.getElementById("inputMonto");
        const botonConfirmarPuja = document.getElementById("btnConfirmarPuja");

        //Variable auxiliar para gestionar si la puja actual más alta pertenece al usuario en sesión.
        let esPujaActual = @(Model.EsPujaActual ? "true" : "false");

        //Inicialización de conexión con el Hub de SignalR.
        const connection = new signalR.HubConnectionBuilder()
                                      .withUrl("/hubs/subasta")
                                      .withAutomaticReconnect()
                                      .build();

        //Ejecucción inmediata del tick de tiempo restante y configuración de un loop de ejecucción cada segundo.
         tick();
        const intervalId = setInterval(tick, 1000);      

        //Establece la conexión con Signal R, uniendo la sesión al grupo de la subasta actual.
        connection.start()
            .then(function() {
                connection.invoke("UnirseASubasta", @Model.Subasta?.IdSubasta);            
            })
            .catch(function(err) {
                console.error("Error al intentar establecer conexión con el Hub de Subastas de SignalR:", err.toString());
            });

        // Función tick que actualiza el temporizador en tiempo real.
        function tick() {
            const diferenciaSegundos = Math.floor((fechaCierre - new Date()) / 1000);

            // Subasta cerrada.
            if (diferenciaSegundos <= 0) {
                horas.textContent = "00";
                minutos.textContent = "00"; 
                segundos.textContent = "00";
                timerStatusText.textContent    = "Subasta finalizada";
                timerStatusIcon.className      = "fa-solid fa-circle-xmark";               
                timerIcon.style.color          = "var(--ss-muted)";
                timerBlock.classList.remove("timer-critical");
                timerBlock.classList.add("timer-ended");
                botonPujar.classList.add("fab-disabled");
                botonPujar.setAttribute("data-bs-toggle", "");  
                
                if (intervalId != null)
                    clearInterval(intervalId);

                return;
            }

            // Si a la subasta le quedan menos de 10 minutos, renderiza estilos "críticos".
            if (diferenciaSegundos <= 600) {
                timerBlock.classList.add("timer-critical");
                timerStatusText.textContent    = "¡Subasta a punto de finalizar!";
                timerStatusIcon.className      = "fa-solid fa-circle-exclamation";               
                timerIcon.style.color          = "var(--ss-danger)";
            }

            renderizarTiempoRestante(diferenciaSegundos);
        }

        // Actualiza los valores de tiempo restante a cada uno de los segmentos de digitos. (horas, minutos y segundos)
        function renderizarTiempoRestante(totalSeconds) {
            horas.textContent = pad(Math.floor(totalSeconds / 3600));
            minutos.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
            segundos.textContent = pad(totalSeconds % 60);
        }

        //Asignación de un formato específico para el valor enviado.
        function pad(n) { return String(n).padStart(2, "0"); }

        //Evento de refrescamiento de la interfaz al agregar una nueva puja.
        connection.on("NuevaPuja", function(data) {
            //Puja actual más alta.
            document.getElementById("pujaActualDisplay").textContent = data.montoFormateado;

            const spanTotalPujas = document.getElementById("cantidadPujas");

            //Si es la primera puja registrada construye el span con el total de pujas, de lo contrario solo lo actualiza.
            if (spanTotalPujas == null)
                document.getElementById("divTituloHistorialPujas").insertAdjacentHTML("beforeend", '<span class="badge text-bg-primary ms-1" id="cantidadPujas">1</span>')           
            else
                spanTotalPujas.textContent = Number(spanTotalPujas.textContent) + 1;
          
            const tablaHistorial = document.getElementById("tablaHistorial");            
            const nuevaFila =  `<tr class="bid-leader">
                                    <td>
                                        <div class="bid-user-cell">
                                            <div class="bid-avatar">
                                                ${data.inicialesUsuario}
                                            </div>

                                            <span class="bid-username">${data.nombreUsuario}</span>

                                            <span class="badge text-bg-success" id="liderSubasta">
                                                <i class="fa-solid fa-trophy" style="font-size:.8rem"></i> Líder
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="bid-amount leader-amount">
                                            ${data.montoFormateado}
                                        </span>
                                    </td>

                                    <td class="bid-date">
                                        ${data.fecha}
                                    </td>
                               </tr>`;

            //Si es la primera puja construye la tabla de historial y la muestra, de lo contrario añade un nuevo registro como puja líder.
            if (tablaHistorial == null) {
                const tabla = `<table class="bids-table" id="tablaHistorial">
                                   <thead>
                                        <tr>
                                            <th>Usuario</th>
                                            <th>Monto</th>
                                            <th>Fecha y hora</th>
                                        </tr>
                                   </thead>
                                   <tbody id="bodyHistorial">
                                        ${nuevaFila}
                                   </tbody>
                               </table>`;

                document.getElementById("mensajeSinPujas").style.display = "none";
                document.getElementById("seccionSubastas").insertAdjacentHTML("beforeend", tabla);
            }
            else {
                //Elimina los estilos de registro líder a la puja que anteriormente era la mayor.
                document.getElementById("liderSubasta").remove();
                document.querySelector(".leader-amount").classList.remove("leader-amount");
                document.querySelector(".bid-leader").classList.remove("bid-leader");

                document.getElementById("bodyHistorial").insertAdjacentHTML("afterbegin", nuevaFila);         
            }

            //Actualiza los valores del modal de Pujar.
            const montoMinProximaPuja = data.monto + @Model.Subasta?.IncrementoMinimo;

            document.getElementById("montoMinimoDisplay").textContent = montoMinProximaPuja.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0});;
            inputMontoPuja.value = "";
            inputMontoPuja.setAttribute("placeholder", montoMinProximaPuja);
            inputMontoPuja.setAttribute("min", montoMinProximaPuja);
            botonConfirmarPuja.setAttribute("disabled", true);
            
            //Notificación de puja superada en caso de que la puja registrada haya sido realizada por otro usuario y el usuario en sesión tuviera previamente la puja más alta.
            if (esPujaActual && data.idUsuario != @Model.IdUsuarioSesion) {
                Swal.fire({
                    icon: 'warning',
                    title: '¡Su puja ha sido superada!',
                    toast: true,
                    position: 'top-end',
                    showCloseButton: true,
                    showConfirmButton: false,
                    customClass: {
                        closeButton: 'toast-close-button'
                    }
                });

                esPujaActual = false;
            }
            else if (data.idUsuario == @Model.IdUsuarioSesion)
                esPujaActual = true;
        });

        //Evento change para controlar la validez del monto a pujar.
        document.getElementById("inputMonto").addEventListener("change", (event) => {           
            const errorMontoPuja = document.getElementById("errorMontoText");           

            if (Number(inputMontoPuja.getAttribute("min")) > Number(event.target.value)) {
                errorMontoPuja.textContent = "El monto de puja ingresado no es válido.";
                botonConfirmarPuja.setAttribute("disabled", true);
            }
            else {
                errorMontoPuja.textContent = "";
                botonConfirmarPuja.removeAttribute("disabled");
            }
        });

        //Método asincróno de pujas.
        function realizarPuja() {                    
            try {
                const nombreCamiseta = "@Model.Subasta?.IdCamisetaNavigation?.Nombre";

                Swal.fire({
                    title: "Confirmación de Puja",
                    text: `¿Está seguro que desea registrar la puja digitada para la subasta de ${nombreCamiseta}?`,
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Sí, continuar",
                    cancelButtonText: "Cancelar",
                    confirmButtonColor: "#18bc9c"
                }).then(async function (result) {
                    if (result.isConfirmed) {
                        const request = {
                            IdSubasta: @Model.Subasta?.IdSubasta,
                            Monto: parseInt(inputMontoPuja.value),
                            IdUsuarioPuja: @Model.IdUsuarioSesion,                         
                        };

                        const response = await fetch("/Subasta/Pujar", {
                            method:  "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(request)
                        });

                        const responseJSON = await response.json();

                        if (responseJSON.success)
                            Swal.fire({
                                icon: 'success',
                                title: 'Puja registrada',
                                text: responseJSON.message,
                            }).then(() => {
                                //Cierra el modal de Pujar para mayor accesibilidad.
                                const modalPujar = bootstrap.Modal.getInstance(document.getElementById("modalPujar"));

                                modalPujar.hide();
                            });                   
                        else
                            Swal.fire({
                                icon: 'error',
                                title: 'Error en registro de puja',
                                text: responseJSON.message,
                            });
                    }
                 });          
            } 
            catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error en registro de puja',
                    text: 'Ha ocurrido un error al intentar registrar la puja ingresada. Por favor intente de nuevo más tarde.',
                });

                console.log(err);
            }
        }

        //Evento de refrescamiento de la interfaz al finalizar una subasta.
        connection.on("SubastaCerrada", function(data) {
            if (data.tieneGanador) {
                document.getElementById("liderSubasta").innerHTML = '<i class="fa-solid fa-trophy" style="font-size:.8rem"></i> Ganador';

                Swal.fire({
                    icon: 'info',
                    title: `¡La subasta ha sido ganada por el usuario: ${data.nombreGanador}!`,
                    toast: true,
                    position: 'top-end',
                    showCloseButton: true,
                    showConfirmButton: false,
                    customClass: {
                        closeButton: 'toast-close-button'
                    }
                });
            }
            else {
                document.getElementById("mensajeSinPujas").textContent = "Subasta finalizada sin pujas.";

                Swal.fire({
                    icon: 'info',
                    title: 'La subasta ha finalizada sin pujas.',
                    toast: true,
                    position: 'top-end',
                    showCloseButton: true,
                    showConfirmButton: false,
                    customClass: {
                        closeButton: 'toast-close-button'
                    }
                });
            }
                
            //Cierra el modal de Pujar en caso de que alguien lo tenga abierto.
            var modalInstance = bootstrap.Modal.getInstance(document.getElementById('miModal'));

            modalInstance.hide();
        });
    </script>
}