@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>
@{
    ViewData["Title"] = "Subastas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">
            <i class="fa-solid fa-gavel text-primary me-2"></i>Todas las Subastas
        </h1>
        <p class="text-muted mb-0">Total: <strong>@total</strong> subastas registradas.</p>
        <button type="button" class="btn btn-outline-success btn-sm" style="border-radius:12px">
            <i class="bi bi-plus-circle"></i>
            Agregar subasta
        </button>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>No hay subastas registradas.</div>
    </div>
}
else
{
    <section aria-label="Listado de subastas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation?.ImagenCamiseta?.FirstOrDefault();
                var esActiva = item.FechaCompra == null && item.FechaCierre > DateTime.Now;
                var fueVendida = item.FechaCompra != null;
                var estadoBadge = esActiva ? "primary" : fueVendida ? "success" : "secondary";
                var estadoTexto = esActiva ? "Activa" : fueVendida ? "Vendida" : "Finalizada";
                var estadoIcono = esActiva ? "fa-solid fa-gavel" : fueVendida ? "bi-check-circle" : "bi-x-circle";

                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <!-- Imagen con badge de estado -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height: 240px;">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="Imagen de @item.IdCamisetaNavigation.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Sin imagen</span>
                                </div>
                            }
                        <!-- Badge estado sobre imagen -->
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-@estadoBadge">
                                <i class=" @estadoIcono me-1"></i>@estadoTexto
                            </span>
                        </div>
                    </div>

                    <!-- Contenido -->
                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-2 text-truncate"
                            title="@item.IdCamisetaNavigation?.Nombre">
                            @item.IdCamisetaNavigation?.Nombre
                        </h2>

                        <!-- Precio y pujas -->
                        <div class="d-flex gap-2 mb-2">
                            <span class="badge rounded-pill bg-primary px-3 py-2">
                                <i class="bi bi-cash me-1"></i>
                                @(item.Puja.Any()
                                                            ? item.Puja.Max(p => p.Monto).ToString("C")
                                                            : item.PrecioBase.ToString("C"))
                                                                                        </span>
                                                                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                                                                            <i class="bi bi-people me-1"></i>
                                                                                            @item.Puja.Count pujas
                                                                                        </span>
                                                                                    </div>

                        <!-- Fecha cierre -->
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i class="bi bi-calendar"></i>
                            <span>
                                @(esActiva
                                                            ? $"Cierra el {item.FechaCierre:d/M/yy HH:mm}"
                                                            : $"Cerró el {item.FechaCierre:d/M/yy HH:mm}")
                        </span>
                    </div>
                </div>

                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3 px-3">
                            <a asp-controller="Subasta"
                               asp-action="Details"
                               asp-route-id="@item.IdSubasta"
                               class="btn btn-primary w-100">
                                <i class="bi bi-eye me-1"></i> Ver subasta
                            </a>
                        </div>

                    </article>
                </div>
                }
        </div>
    </section>
}

@section Scripts {
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
