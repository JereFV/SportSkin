@model SportSkin.Web.ViewModels.CamisetaViewModel

@{
    ViewData["Title"] = "Camisetas";
    var total = Model?.Camisetas?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">
            <i class="fa-solid fa-shirt text-primary"></i>&nbsp;
            <span data-i18n="shirts:myShirts"></span>
        </h1>

        <p class="text-muted mb-0">
            <span data-i18n="shirts:totalLabel"></span>
            <strong>@total</strong>.
        </p>

        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#createModal" style="border-radius:12px; margin-top: 0.5rem">
            <i class="bi bi-plus-circle"></i>
            <span data-i18n="actions.addShirt"> </span>
        </button>
    </div>
    <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle d-flex align-items-center gap-2"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-funnel"></i>
            <span data-i18n="filters.title"></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li>
                <h6 class="dropdown-header" data-i18n="filters.byStatus"></h6>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "vendidos" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="vendidos">
                    <i class="bi bi-check-circle text-success"></i>
                    <span data-i18n="filters.sold"></span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "ensubasta" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="ensubasta">
                    <i class="fa-solid fa-gavel text-primary"></i>
                    <span data-i18n="status.inAuction"></span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2
                   @(ViewBag.FiltroActual == "sinsubasta" ? "active" : "")"
                   asp-action="CamisetaIndex" asp-route-filtro="sinsubasta">
                    <i class="bi bi-tag text-secondary"></i>
                    <span data-i18n="status.available"></span>
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-action="CamisetaIndex">
                    <i class="bi bi-x-circle text-danger"></i>
                    <span data-i18n="actions.clearFilter"> </span>
                </a>
            </li>
        </ul>
    </div>
</div>

@if (Model?.Camisetas == null || !Model.Camisetas.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div data-i18n="shirts:noShirts"></div>
    </div>
}
else
{
    <section aria-label="Listado de camisetas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model.Camisetas)
            {
                var primeraImagen = item.ImagenesCamiseta?.FirstOrDefault();
                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <div class="rounded-top overflow-hidden bg-body-tertiary" style="height:320px">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="@item.Nombre" loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                    </div>

                    <div class="card-body">
                        <h2 class="h6 fw-semibold mb-1 text-truncate" title="@item.Nombre">
                            @item.Nombre
                        </h2>
                        <div class="d-flex gap-2 mb-0">
                            <span class="badge rounded-pill bg-secondary px-3 py-2">
                                @(item.CondicionCamisetaNavigation?.Nombre ?? "—")
                            </span>
                            <span class="badge rounded-pill px-3 py-2
                                        @(item.EstadoCamisetaNavigation?.Nombre switch
                                  {
                                      "Disponible" => "bg-success",
                                      "En Subasta" => "bg-warning",
                                      "Vendida" => "bg-danger",
                                      _ => "bg-secondary"
                                  })">
                            @(item.EstadoCamisetaNavigation?.Nombre ?? "—")
                        </span>
                    </div>
                </div>

                    <div class="card-footer bg-body border-0 pt-0 pb-2">
                        <div class="d-flex gap-2 px-2">
                            <a asp-controller="Subasta" asp-action="Create"
                               asp-route-id="@item.IdCamiseta"
                               class="btn btn-primary flex-fill">
                                <i class="bi bi-cart-check me-1"></i>
                                <span data-i18n="actions.auction"></span>
                            </a>
                            <a asp-controller="Camiseta" asp-action="CamisetaDetails"
                               asp-route-id="@item.IdCamiseta"
                               class="btn btn-info flex-fill">
                                <i class="bi bi-info-circle me-1"></i>
                                <span data-i18n="actions.details"> </span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
                }
        </div>
    </section>
}

@section Scripts {
    <partial name="_CamisetaCreate" model="Model?.CreacionCamiseta" />

    <script>
        $(document).ready(function() {
            $('#categorias').multiselect({
                nonSelectedText: 'Seleccione alguna categoría',
                buttonWidth: '100%',
                buttonTextAlignment: 'left',
                allSelectedText: false,
                numberDisplayed: 0
            });
        });
    </script>

    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
