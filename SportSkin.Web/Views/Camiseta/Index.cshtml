@model IEnumerable<SportSkin.Application.DTOs.CamisetaDTO>

@{
    ViewData["Title"] = "Camisetas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Mis camisetas</h1>
        <p class="text-muted mb-0">Explora el catálogo disponible. Total: <strong>@total</strong>.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Libro" asp-action="LibroReportPDF"
           class="btn btn-outline-secondary">
            <i class="bi bi-filetype-pdf me-1"></i> Exportar PDF
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div>No hay camisetas disponibles en este momento.</div>
    </div>
}
else
{
    <section aria-label="Listado de camisetas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">

            @foreach (var item in Model)
            {
                var primeraImagen = item.ImagenCamiseta?.FirstOrDefault();
                <div class="col">
                    <article class="card h-100 shadow-sm border-0">
                        <!-- Imagen -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary" style="height: 320px;">
                            @* Si hay imagen, la mostramos; si no, placeholder *@
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover  rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="Imagen de @item.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Sin imagen</span>
                                </div>
                            }
                        </div>

                        <!-- Contenido -->
                        <div class="card-body">
                            <h2 class="h6 fw-semibold mb-1 text-truncate" title="@item.Nombre">
                                @item.Nombre
                            </h2>

                            <!-- Condición y Estado -->
                            <div class="d-flex gap-2 mb-0">
                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                    @(item.IdCondicionCamisetaNavigation?.Nombre ?? "Condición")
                                </span>
                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                    @(item.Estado ? "Activo" : "Inactivo")
                                </span>
                            </div>

                        </div>

                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3">
                            <div class="d-grid gap-2 px-2">
                                <a asp-controller="Subasta"
                                   asp-action="Create"
                                   asp-route-id="@item.IdCamiseta"
                                   class="btn btn-primary">
                                    <i class="bi bi-eye me-1"></i> Subastar
                                </a>
                                <a asp-controller="Camiseta"
                                   asp-action="Details"
                                   asp-route-id="@item.IdCamiseta"
                                   class="btn btn-info flex-fill">
                                    <i class="bi bi-plus-circle me-1"></i> Ver detalle
                                </a>


                                @*<button type="button" class="btn btn-outline-secondary">
                                    <i class="bi bi-bag-plus me-1"></i> Agregar
                                </button>*@
                            </div>
                        </div>
                    </article>
                </div>
            }

        </div>
    </section>
}

@section Scripts {
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
