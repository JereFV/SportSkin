@model IEnumerable<SportSkin.Application.DTOs.SubastaDTO>
@{
    ViewData["Title"] = "Subastas Finalizadas";
    var total = Model?.Count() ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-check-circle text-secondary me-2"></i>
            <span data-i18n="auctions:finishedAuctions">Subastas Finalizadas</span>
        </h1>
        <p class="text-muted mb-0">
            <span data-i18n="auctions:closedLabel">Cerradas. Total:</span> <strong>@total</strong>.
        </p>
    </div>

    <!-- Filtro por fechas -->
    <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small text-muted mb-1" data-i18n="filters.from">Desde</label>
            <input type="date" id="inputDesde" name="desde" value="@ViewBag.Desde"
                   class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small text-muted mb-1" data-i18n="filters.until">Hasta</label>
            <input type="date" id="inputHasta" name="hasta" value="@ViewBag.Hasta"
                   class="form-control form-control-sm" />
        </div>
        <button type="submit" id="btnFiltrar" class="btn btn-secondary btn-sm">
            <i class="bi bi-search me-1"></i> <span data-i18n="actions.filter">Filtrar</span>
        </button>
        @if (ViewBag.Desde != null || ViewBag.Hasta != null)
        {
            <a asp-action="Finalizadas" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle me-1"></i> <span data-i18n="actions.clear">Limpiar</span>
            </a>
        }
    </form>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <div data-i18n="auctions:noFinished">No hay subastas finalizadas.</div>
    </div>
}
else
{
    <section aria-label="Subastas finalizadas">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                var primeraImagen = item.IdCamisetaNavigation?.ImagenesCamiseta?.FirstOrDefault();
                var fueVendida = item.IdEstadoSubasta==2;
                var esActiva = item.FechaCompra == null && item.FechaCierre > DateTime.Now;
                var estadoTexto = fueVendida ? "Vendida" : item.Puja.Count<=0 ? "Sin compra" : "Cancelada";
                var estadoColor = fueVendida ? "success" : "danger";
                var estadoIcono = esActiva ? "fa-solid fa-gavel" : fueVendida ? "bi bi-check-circle" : "bi bi-x-circle";
                var precioFinal = fueVendida
                ? (item.MontoCompra?.ToString("C") ?? item.PrecioBase.ToString("C"))
                : item.Puja.Any()
                ? item.Puja.Max(p => p.Monto).ToString("C")
                : item.PrecioBase.ToString("C");

                <div class="col">
                    <article class="card h-100 shadow-sm border-0">

                        <!-- Imagen -->
                        <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height: 240px;">
                            @if (primeraImagen != null)
                            {
                                <img class="w-100 h-100 object-fit-cover rounded-top"
                                     src="@primeraImagen.RutaImagen"
                                     alt="@item.IdCamisetaNavigation?.Nombre"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                    <i class="bi bi-image fs-1"></i>
                                    <span class="small">Foto/Fotos</span>
                                </div>
                            }

                            <!-- Badge estado -->
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-@estadoColor">
                                    <i class="@estadoIcono me-1"></i>@estadoTexto
                                </span>
                            </div>
                        </div>

                        <!-- Contenido -->
                        <div class="card-body">
                            <h2 class="h6 fw-semibold mb-2 text-truncate"
                                title="@item.IdCamisetaNavigation?.Nombre">
                                @item.IdCamisetaNavigation?.Nombre
                            </h2>

                            <!-- Estado final y precio en misma línea como el mockup -->
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                    <i class="bi bi-people me-1"></i>@item.Puja.Count <span data-i18n="auctions:bids.count" data-i18n-options='{"count":@item.Puja.Count}'></span>
                                </span>

                                <span class="small text-muted">
                                    <span data-i18n="auctions:fields.basePrice">Precio:</span> <span class="fw-semibold">@precioFinal</span>
                                </span>
                            </div>


                            <!-- Fecha cierre -->
                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="bi bi-clock"></i>
                                <span><span data-i18n="auctions:time.closeDate">Fecha de cierre:</span> @item.FechaCierre.ToString("d/M/yy HH:mm")</span>
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="card-footer bg-body border-0 pt-0 pb-3 px-3">
                            <a asp-controller="Subasta"
                               asp-action="Detalle"
                               asp-route-id="@item.IdSubasta"
                               class="btn btn-outline-secondary w-100">
                                <i class="bi bi-eye me-1"></i> <span data-i18n="actions.details">Ver detalle</span>
                            </a>
                        </div>

                    </article>
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputDesde= document.getElementById('inputDesde');
            const inputHasta = document.getElementById('inputHasta');
            const btnFiltrar = document.getElementById('btnFiltrar');


            function verificarBoton() {
                if (inputDesde.value && !inputHasta.value || !inputDesde.value && inputHasta.value) {
                    btnFiltrar.disabled = true;
                    btnFiltrar.title = "Debes ingresar la fecha hasta";
                } else {
                    btnFiltrar.disabled = false;
                    btnFiltrar.title = "";
                }
            }

            inputDesde.addEventListener('change',function(){
                if(!this.value) return;
                const desde = new Date(this.value);

                //calcular máximo (1 mes después)
                const maxHasta = new Date(desde);
                maxHasta.setMonth(desde.getMonth()+1);
                // Cuando cambia "desde", el mínimo de "hasta" se actualiza
                inputHasta.min= this.value;
                inputHasta.max = maxHasta.toISOString().split('T')[0];
                //Si hasta ya tenía una fecha la limpia
                if(inputHasta.value && inputHasta< this.value){
                    inputHasta.value='';
                }
                verificarBoton();
            });

            inputHasta.addEventListener('change', function () {
                // Cuando cambia "hasta", el máximo de "desde" se actualiza
                inputDesde.max = this.value;
                verificarBoton();
            });
        });
    </script>
    <style>
        .card:hover {
            transform: translateY(-3px);
            transition: transform .18s ease;
        }

        .badge.rounded-pill {
            font-size: 0.8rem;
        }
    </style>
}
