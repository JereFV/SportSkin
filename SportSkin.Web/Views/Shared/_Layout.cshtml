<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportSkin</title>
    <script type="importmap"></script>
    <!--Preconección (mejorar carga CDN)-->
    <link rel="preconnect" href="https://cdnjs.cloudfare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!--Boostrap 5.3.8-->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <!--Boostrap Icons-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!--SweetAlert 2-->
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <!--Datatables-->
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
    <!--Font Awesome-->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <!--Boostrap Multiselect-->  
    <link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css" />
    <!--Estilos propios-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-body">
    <!-- Accesibilidad: salto a contenido -->
    <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-body border rounded"
       href="#mainContent">
        Saltar al contenido
    </a>

    <header class="sticky-top">
        @await Html.PartialAsync("_Menu")
    </header>

    <main id="mainContent" class="flex-grow-1">
        <div class="container py-3">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-auto border-top">
        <div class="container py-3 small text-muted d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">
            <div>
                &copy; @DateTime.Now.Year - SportSkin by Rodrigo Herrera y Jeremy Fuentes
            </div>
            <div>
                <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    "La piel del deporte"
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!--Jquery-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!--Datatables-->
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <!--SweetAlert 2-->
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <!--Boostrap Multiselect-->
    <script src="~/lib/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>

    <!-- SWEETALERT NOTIFICATION -->
    @if (TempData["Notificacion"] != null || ViewBag.Notificacion != null)
    {
        var notificacion = TempData["Notificacion"] ?? ViewBag.Notificacion;
        <script type="text/javascript">

            const payload = @Html.Raw(notificacion);

            if (payload) {
                Swal.fire(payload);
            }
        </script>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
