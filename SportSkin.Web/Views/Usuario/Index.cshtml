@model IEnumerable<SportSkin.Web.ViewModels.UsuarioViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<h2>
    <i class="fa-solid fa-users text-primary"></i>
    &nbspListado de Usuarios
</h2>

<br />

@* <p>
    <a asp-action="Create">Create New</a>
</p> *@
<table class="table" id="usersList">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreCompleto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? Enumerable.Empty<SportSkin.Web.ViewModels.UsuarioViewModel>())
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreCompleto)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rol)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>               
                <td class="col-md-6">
                    <div>
                        <button type="button" class="btn btn-outline-info">
                            <i class="fa-solid fa-circle-info"></i>&nbspVer detalle
                        </button>

                        <button type="button" class="btn btn-outline-primary">
                            <i class="fa-regular fa-pen-to-square"></i>&nbspEditar
                        </button>

                        <button type="button" class="btn btn-outline-dark">
                            <i class="fa-solid fa-key"></i>&nbspCambiar Contraseña
                        </button>

                        <div class="userstable-status-btngroup">
                            @if (item.Estado == "Activo")
                            {
                                <button type="button" class="btn btn-outline-danger">
                                    <i class="fa-solid fa-ban"></i>&nbspDeshabilitar
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-success">
                                    <i class="fa-solid fa-circle-check"></i>&nbspHabilitar
                                </button>
                            }     
                        </div>
                                         
                    </div>                              
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts{
    <script>     
        $(document).ready(function () {
             //Inicialización del listado utilizando datatables.
            $('#usersList').DataTable({
                "columnDefs": [
                    { "className": "dt-center", "targets": [0, 1, 2, 3] }
                ]
            });
        });
    </script>
}


