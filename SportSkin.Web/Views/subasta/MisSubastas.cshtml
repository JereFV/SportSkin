@model SportSkin.Web.ViewModels.MisSubastasViewModel
@{
    ViewData["Title"] = "Mis Subastas";
    var subastas = Model.Subastas;
    var total = subastas.Count();
    var activas = subastas.Count(s => s.IdEstadoSubasta == 1);
    var vendidas = subastas.Count(s => s.IdEstadoSubasta == 2);
    var finalizadas = subastas.Count(s => s.IdEstadoSubasta == 3);
    var borradores = subastas.Count(s => s.IdEstadoSubasta == 4);
    var canceladas = subastas.Count(s => s.IdEstadoSubasta == 5);
    var publicadas = subastas.Count(s => s.IdEstadoSubasta == 6);
}

@* ─── Encabezado ─── *@
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">
            <i class="fa-solid fa-gavel text-primary me-2"></i>
            <span data-i18n="auctions:myAuctions"></span>
        </h1>
        <p class="text-muted mb-0 small">
            <span data-i18n="auctions:auctionManagement"></span> <strong>@Model.NombreVendedor</strong>
        </p>
    </div>
    <button type="button" class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#modalCrear">
        <i class="bi bi-plus-circle me-1"></i>
        <span data-i18n="actions.addAuction"></span>
    </button>
</div>

@* ─── Resumen rápido ─── *@
<div class="row g-3 mb-4 justify-content-center">
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-primary bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-primary">@publicadas</div>
            <div class="small text-muted"><span data-i18n="auctions:published"></span></div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-success bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-success">@activas</div>
            <div class="small text-muted"><span data-i18n="auctions:live"></span></div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-info bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-info">@vendidas</div>
            <div class="small text-muted"><span data-i18n="auctions:sold"></span></div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-danger bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-danger">@finalizadas</div>
            <div class="small text-muted"><span data-i18n="auctions:ended"></span></div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-warning bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-warning">@borradores</div>
            <div class="small text-muted"><span data-i18n="auctions:drafts"></span></div>
        </div>
    </div>
    <div class="col-6 col-sm-4 col-md-2">
        <div class="card border-0 bg-secondary bg-opacity-10 text-center py-3">
            <div class="fs-4 fw-bold text-secondary">@canceladas</div>
            <div class="small text-muted"><span data-i18n="auctions:cancelled"></span></div>
        </div>
    </div>
</div>

@* ─── Listado de cards ─── *@
@if (!subastas.Any())
{
    <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle me-2 fs-5"></i>
        <div data-i18n="[html]auctions:noMineFull"></div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @foreach (var item in subastas)
        {
            var primeraImagen = item.IdCamisetaNavigation?.ImagenesCamiseta?.FirstOrDefault();
            var estadoId = item.IdEstadoSubasta;
            var estadoNombre = item.IdEstadoSubastaNavigation?.Nombre ?? "—";

            var (badgeColor, iconoEstado) = estadoId switch
            {
                1 => ("success", "bi-lightning-charge"),
                2 => ("info", "bi-cart-check"),
                3 => ("danger", "bi-megaphone"),
                4 => ("warning", "bi-pencil-square"),
                5 => ("secondary", "bi-x-circle"),
                6 => ("primary", "bi-broadcast"),
                _ => ("dark", "bi-question-circle")
            };

            bool puedeEditar = estadoId == 4;
            bool puedePublicar = estadoId == 4;
            bool puedeCancelar = (estadoId == 1 || estadoId == 5) && item.Puja.Count <= 0;

            <div class="col">
                <article class="card h-100 shadow-sm border-0">
                    <div class="rounded-top overflow-hidden bg-body-tertiary position-relative" style="height:300px;">
                        @if (primeraImagen != null)
                        {
                            <img class="w-100 h-100 object-fit-cover"
                                 src="@primeraImagen.RutaImagen"
                                 alt="@item.IdCamisetaNavigation?.Nombre" loading="lazy" />
                        }
                        else
                        {
                            <div class="d-flex flex-column justify-content-center align-items-center text-muted h-100">
                                <i class="bi bi-image fs-1"></i>
                                <span class="small" data-i18n="errors.noData"></span>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-@badgeColor">
                                <i class="bi @iconoEstado me-1"></i>@estadoNombre
                            </span>
                        </div>
                    </div>

                    <div class="card-body pb-0">
                        <h2 class="h6 fw-semibold text-truncate mb-1"
                            title="@item.IdCamisetaNavigation?.Nombre">
                            @item.IdCamisetaNavigation?.Nombre
                        </h2>
                        <p class="small text-muted mb-2">
                            <i class="bi bi-calendar3 me-1"></i>
                            @item.FechaInicio.ToString("dd/MM/yy") — @item.FechaCierre.ToString("dd/MM/yy HH:mm")
                        </p>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-2 py-1">
                                <span data-i18n="auctions:fields.basePrice"></span>: $@item.PrecioBase.ToString("N0")
                            </span>
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis px-2 py-1">
                                <i class="bi bi-people me-1"></i>@item.Puja.Count
                                <span data-i18n="auctions:bids.count_other"></span>
                            </span>
                        </div>
                    </div>

                    <div class="card-footer bg-body border-0 pb-3 pt-2 d-flex gap-2">
                        <a asp-controller="Subasta" asp-action="Detalle"
                           asp-route-id="@item.IdSubasta"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i>
                            <span data-i18n="actions.details"></span>
                        </a>

                        <div class="dropdown ms-auto">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                    type="button" data-bs-toggle="dropdown">
                                <span data-i18n="actions.actionsS"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                @if (puedeEditar)
                                {
                                    <li>
                                        <button class="dropdown-item"
                                                onclick="abrirModalEditar(@item.IdSubasta)">
                                            <i class="bi bi-pencil me-2 text-warning"></i>
                                            <span data-i18n="actions.edit"></span>
                                        </button>
                                    </li>
                                }
                                @if (puedePublicar)
                                {
                                    <li>
                                        <form asp-controller="Subasta" asp-action="Publicar"
                                              method="post" id="formPublicar_@item.IdSubasta">
                                            <input type="hidden" name="id" value="@item.IdSubasta" />
                                            <button type="button" class="dropdown-item"
                                                    onclick="confirmarAccion('formPublicar_@item.IdSubasta', 'publish')">
                                                <i class="bi bi-megaphone me-2 text-info"></i>
                                                <span data-i18n="auctions:actions.publish"></span>
                                            </button>
                                        </form>
                                    </li>
                                }
                                @if (puedeCancelar)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Subasta" asp-action="Cancelar"
                                              method="post" id="formCancelar_@item.IdSubasta">
                                            <input type="hidden" name="id" value="@item.IdSubasta" />
                                            <button type="button" class="dropdown-item text-danger"
                                                    onclick="confirmarAccion('formCancelar_@item.IdSubasta', 'cancel')">
                                                <i class="bi bi-x-circle me-2"></i>
                                                <span data-i18n="auctions:actions.cancelAuction"></span>
                                            </button>
                                        </form>
                                    </li>
                                }
                                @if (!puedeEditar && !puedePublicar && !puedeCancelar)
                                {
                                    <li>
                                        <span class="dropdown-item text-muted small"
                                              data-i18n="auctions:noActions"></span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

@* ═══ MODAL CREAR ═══ *@
<div class="modal fade" id="modalCrear" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 text-white" style="background:#185FA5; padding:1.1rem 1.5rem;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-2 d-flex align-items-center justify-content-center"
                         style="width:32px;height:32px;background:rgba(255,255,255,0.18);">
                        <i class="bi bi-plus-lg" style="font-size:14px;"></i>
                    </div>
                    <h5 class="modal-title mb-0" data-i18n="auctions:modal.createTitle"></h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form id="formCrearSubasta" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:1.5rem;">
                    <div class="d-flex flex-column gap-4">

                        @* Vendedor *@
                        <div class="d-flex align-items-center gap-3 rounded-3 p-3"
                             style="background:var(--bs-secondary-bg);border:0.5px solid var(--bs-border-color);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-semibold"
                                 style="width:38px;height:38px;background:#B5D4F4;color:#0C447C;font-size:13px;">
                                @(string.Concat(Model.FormCrear.NombreVendedor.Split(' ').Take(2).Select(p => p[0])))
                            </div>
                            <div>
                                <p class="mb-0" style="font-size:11px;color:var(--bs-secondary-color);"
                                   data-i18n="auctions:fields.seller"></p>
                                <p class="mb-0 fw-semibold" style="font-size:14px;">@Model.FormCrear.NombreVendedor</p>
                            </div>
                        </div>

                        @* Camiseta *@
                        <div>
                            <p class="mb-2 d-flex align-items-center gap-2"
                               style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;">
                                <i class="bi bi-suit-heart" style="color:#185FA5;"></i>
                                <span data-i18n="auctions:fields.shirt"></span>
                            </p>
                            <select id="c_IdCamiseta" name="IdCamiseta" class="form-select">
                                <option value="" data-i18n="auctions:fields.selectShirt"></option>
                                @foreach (var cam in Model.FormCrear.CamisetasDisponibles)
                                {
                                    <option value="@cam.IdCamiseta">
                                        @cam.Nombre — @cam.CondicionCamisetaNavigation?.Nombre
                                        @(cam.Autografiada ? "★ Autografiada" : "")
                                        (@cam.EquipoNavigation?.Nombre — @cam.Temporada)
                                    </option>
                                }
                            </select>
                            <span class="text-danger small" id="errCamiseta"></span>
                            @if (!Model.FormCrear.CamisetasDisponibles.Any())
                            {
                                <div class="form-text text-warning">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    <span data-i18n="auctions:noActive"></span>
                                </div>
                            }
                        </div>

                        @* Período *@
                        <div>
                            <p class="mb-2 d-flex align-items-center gap-2"
                               style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;">
                                <i class="bi bi-calendar-range" style="color:#185FA5;"></i>
                                <span data-i18n="auctions:fields.period"></span>
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.startDate"></span> <span class="text-danger">*</span>
                                    </label>
                                    <input id="c_FechaInicio" name="FechaInicio" type="datetime-local" class="form-control" />
                                    <span class="text-danger small" id="errFechaInicio"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.closeDate"></span> <span class="text-danger">*</span>
                                    </label>
                                    <input id="c_FechaCierre" name="FechaCierre" type="datetime-local" class="form-control" />
                                    <span class="text-danger small" id="errFechaCierre"></span>
                                </div>
                            </div>
                        </div>

                        @* Precios *@
                        <div>
                            <p class="mb-2 d-flex align-items-center gap-2"
                               style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;">
                                <i class="bi bi-cash-coin" style="color:#185FA5;"></i>
                                <span data-i18n="auctions:fields.prices"></span>
                            </p>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.basePrice"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="c_PrecioBase" name="PrecioBase" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errPrecioBase"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.minIncrement"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="c_IncrementoMinimo" name="IncrementoMinimo" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errIncrementoMinimo"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.buyNowPrice"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="c_PrecioCompraInmediata" name="PrecioCompraInmediata" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errPrecioCompraInmediata"></span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 rounded-3 px-3 py-2"
                                 style="background:#E6F1FB;border:0.5px solid #B5D4F4;">
                                <i class="bi bi-lock-fill" style="font-size:13px;color:#185FA5;"></i>
                                <span style="font-size:13px;color:#0C447C;" data-i18n="auctions:fields.commissionLabel"></span>
                                <span class="ms-auto fw-semibold" style="font-size:13px;color:#0C447C;"
                                      data-i18n="auctions:fields.commissionValue"></span>
                            </div>
                        </div>

                        <div id="erroresCrear" class="alert alert-danger d-none"></div>
                    </div>
                </div>

                <div class="modal-footer border-0" style="background:var(--bs-secondary-bg);padding:1rem 1.5rem;">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                            data-bs-dismiss="modal" data-i18n="actions.cancel"></button>
                    <button type="submit" class="btn btn-sm px-3 text-white d-flex align-items-center gap-2"
                            id="btnGuardarSubasta" style="background:#185FA5;border:none;">
                        <i class="bi bi-floppy"></i>
                        <span data-i18n="auctions:actions.saveDraft"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ═══ MODAL EDITAR ═══ *@
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 text-white" style="background:#BA7517;padding:1.1rem 1.5rem;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-2 d-flex align-items-center justify-content-center"
                         style="width:32px;height:32px;background:rgba(255,255,255,0.18);">
                        <i class="bi bi-pencil-square" style="font-size:14px;"></i>
                    </div>
                    <h5 class="modal-title mb-0" data-i18n="auctions:modal.editTitle"></h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form asp-controller="Subasta" asp-action="Editar" method="post" id="formEditarSubasta" novalidate>
                <input type="hidden" id="e_IdSubasta" name="IdSubasta" />
                <input type="hidden" id="e_IdCamiseta" name="IdCamiseta" />

                <div class="modal-body" style="padding:1.5rem;">
                    <div class="d-flex flex-column gap-4">

                        @* Solo lectura *@
                        <div class="rounded-3 p-3" style="background:var(--bs-secondary-bg);border:0.5px solid var(--bs-border-color);">
                            <p class="mb-2" style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;"
                               data-i18n="auctions:readOnly"></p>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <label class="form-label" style="font-size:11px;color:var(--bs-secondary-color);"
                                           data-i18n="auctions:fields.shirt"></label>
                                    <input id="e_NombreCamiseta" type="text" class="form-control form-control-sm"
                                           style="background:var(--bs-tertiary-bg);" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:11px;color:var(--bs-secondary-color);"
                                           data-i18n="auctions:fields.auctionStatus"></label>
                                    <input id="e_EstadoActual" type="text" class="form-control form-control-sm"
                                           style="background:var(--bs-tertiary-bg);" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" style="font-size:11px;color:var(--bs-secondary-color);"
                                           data-i18n="auctions:fields.seller"></label>
                                    <input id="e_NombreVendedor" type="text" class="form-control form-control-sm"
                                           style="background:var(--bs-tertiary-bg);" readonly />
                                </div>
                            </div>
                        </div>

                        @* Período *@
                        <div>
                            <p class="mb-2 d-flex align-items-center gap-2"
                               style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;">
                                <i class="bi bi-calendar-range" style="color:#BA7517;"></i>
                                <span data-i18n="auctions:fields.period"></span>
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.startDate"></span> <span class="text-danger">*</span>
                                    </label>
                                    <input id="e_FechaInicio" name="FechaInicio" type="datetime-local" class="form-control" />
                                    <span class="text-danger small" id="errEditFechaInicio"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.closeDate"></span> <span class="text-danger">*</span>
                                    </label>
                                    <input id="e_FechaCierre" name="FechaCierre" type="datetime-local" class="form-control" />
                                    <span class="text-danger small" id="errEditFechaCierre"></span>
                                </div>
                            </div>
                        </div>

                        @* Precios *@
                        <div>
                            <p class="mb-2 d-flex align-items-center gap-2"
                               style="font-size:11px;font-weight:500;color:var(--bs-secondary-color);text-transform:uppercase;letter-spacing:.05em;">
                                <i class="bi bi-cash-coin" style="color:#BA7517;"></i>
                                <span data-i18n="auctions:fields.prices"></span>
                            </p>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.basePrice"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="e_PrecioBase" name="PrecioBase" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errEditPrecioBase"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.minIncrement"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="e_IncrementoMinimo" name="IncrementoMinimo" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errEditIncrementoMinimo"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" style="font-size:12px;color:var(--bs-secondary-color);">
                                        <span data-i18n="auctions:fields.buyNowPrice"></span> ($) <span class="text-danger">*</span>
                                    </label>
                                    <input id="e_PrecioCompraInmediata" name="PrecioCompraInmediata" type="number" min="1" step="0.01"
                                           class="form-control" placeholder="0.00" />
                                    <span class="text-danger small" id="errEditCompraInmediata"></span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 rounded-3 px-3 py-2"
                                 style="background:#FAEEDA;border:0.5px solid #FAC775;">
                                <i class="bi bi-lock-fill" style="font-size:13px;color:#854F0B;"></i>
                                <span style="font-size:13px;color:#633806;" data-i18n="auctions:fields.commissionLabel"></span>
                                <span class="ms-auto fw-semibold" style="font-size:13px;color:#633806;"
                                      data-i18n="auctions:fields.commissionValue"></span>
                                <input type="hidden" name="PorcentajeComision" value="3" />
                            </div>
                        </div>

                        <div id="erroresEditar" class="alert alert-danger d-none"></div>
                    </div>
                </div>

                <div class="modal-footer border-0" style="background:var(--bs-secondary-bg);padding:1rem 1.5rem;">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3"
                            data-bs-dismiss="modal" data-i18n="actions.cancel"></button>
                    <button type="submit" class="btn btn-sm px-3 text-white d-flex align-items-center gap-2"
                            style="background:#BA7517;border:none;">
                        <i class="bi bi-floppy"></i>
                        <span data-i18n="actions.save"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            // ── CREAR — AJAX ─────────────────────────────────────────────────
            $('#formCrearSubasta').on('submit', function (e) {
                e.preventDefault();

                // Limpiar errores previos
                limpiarErroresCrear();

                // Validación del lado cliente antes de enviar al servidor
                if (!validarFormCrear()) return;

                const btn = $('#btnGuardarSubasta');
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Guardando...');

                $.ajax({
                    url: '@Url.Action("Crear", "Subasta")',
                    type: 'POST',
                    // serialize() incluye TODOS los inputs del form, incluyendo el __RequestVerificationToken
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            // Mostrar notificación y recargar
                            Swal.fire({
                                title: 'Subasta creada',
                                text:  res.message,
                                icon:  'success',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(function () {
                                location.reload();
                            });
                        } else {
                            // Mostrar errores del servidor en el área de errores del modal
                            mostrarErroresCrear(res.errors);
                            btn.prop('disabled', false).html('<i class="bi bi-floppy me-1"></i> Guardar Borrador');
                        }
                    },
                    error: function (xhr) {
                        // Error HTTP (500, 400, etc.) — mostrar mensaje genérico
                        mostrarErroresCrear(['Error de comunicación (' + xhr.status + '). Intente de nuevo.']);
                        btn.prop('disabled', false).html('<i class="bi bi-floppy me-1"></i> Guardar Borrador');
                    }
                });
            });

            // Limpiar el form al cerrar el modal
            $('#modalCrear').on('hidden.bs.modal', function () {
                $('#formCrearSubasta')[0].reset();
                limpiarErroresCrear();
                $('#btnGuardarSubasta').prop('disabled', false)
                    .html('<i class="bi bi-floppy me-1"></i> Guardar Borrador');
            });

            // ── EDITAR — GET AJAX para cargar datos ──────────────────────────
            // ────────────────────────────────────────────────────────────────
        });

        function abrirModalEditar(id) {
            fetch('/Subasta/GetDatosEditar?id=' + id)
                .then(function (r) {
                    if (r.status === 400) {
                        return r.text().then(function (msg) {
                            Swal.fire('No se puede editar', msg, 'warning');
                            throw new Error(msg);
                        });
                    }
                    if (!r.ok) throw new Error('Error al cargar la subasta.');
                    return r.json();
                })
                .then(function (data) {
                    document.getElementById('e_IdSubasta').value              = data.idSubasta;
                    document.getElementById('e_IdCamiseta').value             = data.idCamiseta;
                    document.getElementById('e_NombreCamiseta').value         = data.nombreCamiseta;
                    document.getElementById('e_EstadoActual').value           = data.estadoActual;
                    document.getElementById('e_NombreVendedor').value         = data.nombreVendedor;
                    document.getElementById('e_FechaInicio').value            = data.fechaInicio;
                    document.getElementById('e_FechaCierre').value            = data.fechaCierre;
                    document.getElementById('e_PrecioBase').value             = data.precioBase;
                    document.getElementById('e_IncrementoMinimo').value       = data.incrementoMinimo;
                    document.getElementById('e_PrecioCompraInmediata').value  = data.precioCompraInmediata;
                    new bootstrap.Modal(document.getElementById('modalEditar')).show();
                })
                .catch(function (err) { console.error(err); });
        }

        // Validación cliente del form de editar
        document.getElementById('formEditarSubasta').addEventListener('submit', function (e) {
            let valido = true;
            const t = (key) => i18next.t(key.split(':')[1] || key, {
                ns: key.includes(':') ? key.split(':')[0] : 'common'
            });

            const inicio = document.getElementById('e_FechaInicio').value;
            const cierre = document.getElementById('e_FechaCierre').value;

            if (!inicio) {
                document.getElementById('errEditFechaInicio').textContent = t('auctions:validation.startDateRequired');
                valido = false;
            } else { document.getElementById('errEditFechaInicio').textContent = ''; }

            if (!cierre) {
                document.getElementById('errEditFechaCierre').textContent = t('auctions:validation.closeDateRequired');
                valido = false;
            } else if (cierre <= inicio) {
                document.getElementById('errEditFechaCierre').textContent = t('auctions:validation.closeDateAfterStart');
                valido = false;
            } else { document.getElementById('errEditFechaCierre').textContent = ''; }

            const precioBase = parseInt(document.getElementById('e_PrecioBase').value);
            if (!precioBase || precioBase < 1) {
                document.getElementById('errEditPrecioBase').textContent = t('auctions:validation.basePriceRequired');
                valido = false;
            } else { document.getElementById('errEditPrecioBase').textContent = ''; }

            const incremento = parseInt(document.getElementById('e_IncrementoMinimo').value);
            if (!incremento || incremento < 1) {
                document.getElementById('errEditIncrementoMinimo').textContent = t('auctions:validation.minIncrementRequired');
                valido = false;
            } else { document.getElementById('errEditIncrementoMinimo').textContent = ''; }

            const compraInmediata = parseInt(document.getElementById('e_PrecioCompraInmediata').value);
            if (!compraInmediata || compraInmediata < 1) {
                document.getElementById('errEditCompraInmediata').textContent = t('auctions:validation.buyNowPriceRequired');
                valido = false;
            } else { document.getElementById('errEditCompraInmediata').textContent = ''; }

            if (!valido) e.preventDefault();
        });

        // ── Publicar / Cancelar — SweetAlert + form.submit() ─────────────
        function confirmarAccion(formId, titulo, texto, icono) {
            Swal.fire({
                title: titulo,
                text:  texto,
                icon:  icono,
                showCancelButton:  true,
                confirmButtonText: 'Sí, continuar',
                cancelButtonText:  'No'
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }

        // ── Helpers de errores para el modal crear ───────────────────────
                function validarFormCrear() {
            let valido = true;
            const t = (key) => i18next.t(key.split(':')[1] || key, {
                ns: key.includes(':') ? key.split(':')[0] : 'common'
            });

            const camiseta = document.getElementById('c_IdCamiseta').value;
            if (!camiseta) {
                document.getElementById('errCamiseta').textContent = t('auctions:validation.selectShirt');
                valido = false;
            } else { document.getElementById('errCamiseta').textContent = ''; }

            const inicio = document.getElementById('c_FechaInicio').value;
            const cierre = document.getElementById('c_FechaCierre').value;

            if (!inicio) {
                document.getElementById('errFechaInicio').textContent = t('auctions:validation.startDateRequired');
                valido = false;
            } else { document.getElementById('errFechaInicio').textContent = ''; }

            if (!cierre) {
                document.getElementById('errFechaCierre').textContent = t('auctions:validation.closeDateRequired');
                valido = false;
            } else if (cierre <= inicio) {
                document.getElementById('errFechaCierre').textContent = t('auctions:validation.closeDateAfterStart');
                valido = false;
            } else { document.getElementById('errFechaCierre').textContent = ''; }

            const precioBase = parseInt(document.getElementById('c_PrecioBase').value);
            if (!precioBase || precioBase < 1) {
                document.getElementById('errPrecioBase').textContent = t('auctions:validation.basePriceRequired');
                valido = false;
            } else { document.getElementById('errPrecioBase').textContent = ''; }

            const incremento = parseInt(document.getElementById('c_IncrementoMinimo').value);
            if (!incremento || incremento < 1) {
                document.getElementById('errIncrementoMinimo').textContent = t('auctions:validation.minIncrementRequired');
                valido = false;
            } else { document.getElementById('errIncrementoMinimo').textContent = ''; }

            const compraInmediata = parseInt(document.getElementById('c_PrecioCompraInmediata').value);
            if (!compraInmediata || compraInmediata < 1) {
                document.getElementById('errPrecioCompraInmediata').textContent = t('auctions:validation.buyNowPriceRequired');
                valido = false;
            } else { document.getElementById('errPrecioCompraInmediata').textContent = ''; }

            return valido;
        }

        function limpiarErroresCrear() {
            ['errCamiseta','errFechaInicio','errFechaCierre','errPrecioBase',
             'errIncrementoMinimo','errPrecioCompraInmediata']
                .forEach(function(id) {
                    const el = document.getElementById(id);
                    if (el) el.textContent = '';
                });
            document.getElementById('erroresCrear').classList.add('d-none');
            document.getElementById('erroresCrear').innerHTML = '';
        }

        function mostrarErroresCrear(errores) {
            if (!errores || errores.length === 0) return;
            const div = document.getElementById('erroresCrear');
            div.classList.remove('d-none');
            div.innerHTML = errores.map(function(e) {
                return '<div><i class="bi bi-exclamation-circle me-1"></i>' + e + '</div>';
            }).join('');
        }
        function confirmarAccion(formId, tipo) {
            const t = (key) => i18next.t(key.split(':')[1] || key, {
                ns: key.includes(':') ? key.split(':')[0] : 'common'
            });

            const configs = {
                publish: {
                    title: t('auctions:confirmPublish.title'),
                    text:  t('auctions:confirmPublish.text'),
                    icon:  'info'
                },
                cancel: {
                    title: t('auctions:confirmCancel.title'),
                    text:  t('auctions:confirmCancel.text'),
                    icon:  'warning'
                }
            };

            const cfg = configs[tipo] || { title: '?', text: '', icon: 'question' };

            Swal.fire({
                title:             cfg.title,
                text:              cfg.text,
                icon:              cfg.icon,
                showCancelButton:  true,
                confirmButtonText: i18next.t('Confirm', { ns: 'common' }),
                cancelButtonText:  i18next.t('Cancel',  { ns: 'common' })
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById(formId).submit();
                }
            });
        }
       

    </script>
}
