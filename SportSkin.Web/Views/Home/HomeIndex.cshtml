@model SportSkin.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO — Carrusel -->
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

    <!-- Indicadores -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
    </div>

    <!-- Slides -->
    <div class="carousel-inner">

        <div class="carousel-item active">
            <div class="carousel-slide d-flex align-items-center justify-content-center"
                 style="background: linear-gradient(135deg, #1a2a3a 0%, #0d6efd 100%); height: 480px;">
                <div class="text-center text-white px-4">
                    <h1 class="display-4 fw-bold mb-3">
                        <i class="bi bi-trophy-fill text-warning me-2"></i>
                        <span data-i18n="home:hero.slide1Title">Bienvenido a SportSkin</span>
                    </h1>
                    <p class="lead mb-4" data-i18n="home:hero.slide1Subtitle">El mercado de subastas de camisetas de fútbol más exclusivo</p>
                    <a asp-controller="Subasta" asp-action="SubastaIndex" class="btn btn-warning btn-lg px-5 fw-semibold">
                        <span data-i18n="home:hero.slide1Button">Ver Subastas Activas</span>
                    </a>
                </div>
            </div>
        </div>
         <div class="carousel-item">
            <div class="carousel-slide d-flex align-items-center justify-content-center"
                 style="background: linear-gradient(135deg, #0a3d1f 0%, #198754 100%); height: 480px;">
                <div class="text-center text-white px-4">
                    <h1 class="display-4 fw-bold mb-3">
                        <i class="bi bi-shirt-fill me-2"></i>
                        <span data-i18n="home:hero.slide2Title">Camisetas Únicas</span>
                    </h1>
                    <p class="lead mb-4" data-i18n="home:hero.slide2Subtitle">Autografiadas, ediciones especiales y piezas históricas del deporte</p>
                    <a asp-controller="Subasta" asp-action="SubastaIndex" class="btn btn-light btn-lg px-5 fw-semibold">
                        <span data-i18n="home:hero.slide2Button">Explorar Camisetas</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="carousel-slide d-flex align-items-center justify-content-center"
                 style="background: linear-gradient(135deg, #2d0a3a 0%, #6f42c1 100%); height: 480px;">
                <div class="text-center text-white px-4">
                    <h1 class="display-4 fw-bold mb-3">
                        <i class="bi bi-lightning-fill text-warning me-2"></i>
                        <span data-i18n="home:hero.slide3Title">Compra Inmediata</span>
                    </h1>
                    <p class="lead mb-4" data-i18n="home:hero.slide3Subtitle">¿No quieres esperar? Aprovecha el precio de compra inmediata</p>
                    <a asp-controller="Subasta" asp-action="Activas" class="btn btn-outline-light btn-lg px-5 fw-semibold">
                        <span data-i18n="home:hero.slide3Button">Ver Disponibles</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <div class="carousel-slide d-flex align-items-center justify-content-center"
                 style="background: linear-gradient(135deg, #0f1923 0%, #1a2a3a 100%); height: 480px;">
                <div class="text-center text-white px-4">
                    <img src="~/images/SportSkinLogo.png"
                         alt="SportSkin"
                         style="height: 200px; object-fit: contain; filter: drop-shadow(0 0 24px rgba(13,110,253,0.6));"
                         class="mb-4">
                    <h2 class="display-5 fw-bold mb-2">SportSkin</h2>
                    <p class="lead opacity-75 mb-0">
                        <span data-i18n="home:hero.slide4Subtitle"></span> <br />
                        <span data-i18n="home:hero.slide4Tagline"></span>
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Controles -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>


<!--ESTADÍSTICAS RÁPIDAS -->
<div class="bg-secondary-subtle  text-white py-4">
    <div class="container-fluid px-4">
        <div class="row text-center g-3">
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <i class="bi bi-fire fs-2 text-warning"></i>
                    <div class="text-start">
                        <div class="fs-2 fw-bold text-warning">@Model.TotalSubastasActivas</div>
                        <div class="small text-secondary" data-i18n="home:stats.activeAuctions">Subastas Activas</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 border-md-start border-secondary">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <i class="bi bi-collection-fill fs-2 text-info"></i>
                    <div class="text-start">
                        <div class="fs-2 fw-bold text-info">@Model.TotalCamisetas</div>
                        <div class="small text-secondary" data-i18n="home:stats.totalShirts">Camisetas en Plataforma</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <i class="bi bi-shield-check-fill fs-2 text-success"></i>
                    <div class="text-start">
                        <div class="fs-2 fw-bold text-success">100%</div>
                        <div class="small text-secondary" data-i18n="home:stats.verified">Camisetas Verificadas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- SUBASTAS MÁS POPULARES-->
<section class="py-5 bg-body " style="margin-top:170px">

    <div class="container-fluid px-4">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-graph-up-arrow text-danger me-2"></i>
                    <span data-i18n="auctions:popular.title">Subastas más populares</span>
                </h2>
                <p class="text-muted mb-0" data-i18n="auctions:popular.subtitle">Las que más atención están generando ahora mismo</p>
            </div>
            <a asp-controller="Subasta" asp-action="SubastaIndex" class="btn btn-outline-primary">
                <span data-i18n="auctions:popular.viewAll">Ver todas</span> <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (!Model.SubastasMasPopulares.Any())
        {
            <div class="alert alert-info d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill"></i>
                <span data-i18n="auctions:popular.noPopular">No hay subastas activas en este momento. ¡Vuelve pronto!</span>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var subasta in Model.SubastasMasPopulares)
                {
                    var imagenUrl = subasta.IdCamisetaNavigation?.ImagenesCamiseta?.FirstOrDefault()?.RutaImagen
                                    ?? "/images/no-image.png";
                    var equipo    = subasta.IdCamisetaNavigation?.EquipoNavigation?.Nombre ?? "—";
                    var jugador   = subasta.IdCamisetaNavigation?.JugadorNavigation != null
                                    ? $"{subasta.IdCamisetaNavigation.JugadorNavigation.Nombre} {subasta.IdCamisetaNavigation.JugadorNavigation.Apellido}"
                                    : "—";
                    var condicion = subasta.IdCamisetaNavigation?.CondicionCamisetaNavigation?.Nombre ?? "—";
                    var pujas     = subasta.Puja?.Count ?? 0;
                    var tiempoRestante = subasta.FechaCierre - DateTime.Now;

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm hover-card">

                            <!-- Imagen -->
                            <div class="position-relative overflow-hidden" style="height: 220px; background:#f8f9fa;">
                                <img src="@imagenUrl"
                                     alt="@subasta.IdCamisetaNavigation?.Nombre"
                                     class="w-100 h-100"
                                     style="object-fit: contain; padding: 12px;"
                                     onerror="this.src='/images/no-image.png'">

                                <!-- Badge pujas -->
                                <span class="position-absolute top-0 end-0 m-2 badge bg-danger fs-6">
                                    <i class="fa-solid fa-gavel me-1"></i>@pujas <span data-i18n="auctions:bids.badge" data-i18n-options='{"count":@pujas}'>@(pujas != 1 ? "pujas" : "puja")</span>
                                </span>

                                <!-- Badge autografiada -->
                                @if (subasta.IdCamisetaNavigation?.Autografiada == true)
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-warning text-dark">
                                        <i class="bi bi-pen-fill me-1"></i>
                                        <span data-i18n="badges.autographed">Autografiada</span>
                                    </span>
                                }
                            </div>

                            <div class="card-body d-flex flex-column gap-2">

                                <!-- Nombre camiseta -->
                                <h5 class="card-title mb-0 fw-bold">
                                    @(subasta.IdCamisetaNavigation?.Nombre ?? "Camiseta")
                                </h5>

                                <!-- Equipo / Jugador -->
                                <div class="d-flex flex-column gap-1 text-muted small">
                                    <span><i class="bi bi-people-fill me-1 text-primary"></i>@equipo</span>
                                    <span><i class="bi bi-person-fill me-1 text-secondary"></i>@jugador</span>
                                    <span><i class="bi bi-star-fill me-1 text-warning"></i>@condicion</span>
                                </div>

                                <hr class="my-1">

                                <!-- Precios -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="small text-muted" data-i18n="auctions:popular.basePrice">Precio base</div>
                                        <div class="fw-bold text-success fs-5">
                                            ₡@subasta.PrecioBase.ToString("N0")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="small text-muted" data-i18n="auctions:popular.buyNow">Compra inmediata</div>
                                        <div class="fw-bold text-primary fs-5">
                                            ₡@subasta.PrecioCompraInmediata.ToString("N0")
                                        </div>
                                    </div>
                                </div>

                                <!-- Tiempo restante -->
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <i class="bi bi-clock text-danger"></i>
                                    @if (tiempoRestante.TotalHours >= 24)
                                    {
                                        <span class="small text-danger fw-semibold">
                                            <span data-i18n="auctions:time.closesIn">Cierra en</span> @((int)tiempoRestante.TotalDays) <span data-i18n="auctions:time.days" data-i18n-options='{"count":@((int)tiempoRestante.TotalDays)}'>@((int)tiempoRestante.TotalDays != 1 ? "días" : "día")</span>
                                        </span>
                                    }
                                    else if (tiempoRestante.TotalMinutes > 0)
                                    {
                                        <span class="small text-danger fw-semibold">
                                            <span data-i18n="auctions:time.closesIn">Cierra en</span>
                                            @tiempoRestante.Hours <span data-i18n="auctions:time.hours" data-i18n-options='{"count":@tiempoRestante.Hours}'>@(tiempoRestante.Hours != 1 ? "horas" : "hora")</span>
                                            @tiempoRestante.Minutes <span data-i18n="auctions:time.min" data-i18n-options='{"count":@tiempoRestante.Minutes}'>@(tiempoRestante.Minutes != 1 ? "minutos" : "minuto")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted" data-i18n="auctions:time.closed">Cerrada</span>
                                    }
                                </div>

                            </div>

                            <!-- Footer -->
                            <div class="card-footer border-0 bg-transparent pb-3">
                                <a asp-controller="Subastas"
                                   asp-action="Details"
                                   asp-route-id="@subasta.IdSubasta"
                                   class="btn btn-primary w-100">
                                    <i class="bi bi-eye me-2"></i>
                                    <span data-i18n="actions.viewAuction">Ver Subasta</span>
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</section>


<!-- BANNER CTA — Registro / Login -->
<section class="py-5"
         style="background: linear-gradient(135deg, #0d6efd 0%, #6f42c1 100%);">
    <div class="container-fluid px-4 text-center text-white">
        <h2 class="fw-bold mb-2" data-i18n="home:cta.title">¿Listo para participar?</h2>
        <p class="lead mb-4 opacity-75" data-i18n="home:cta.subtitle">
            Regístrate gratis y empieza a pujar por las camisetas más exclusivas del deporte
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="#"
               class="btn btn-warning btn-lg px-5 fw-semibold">
                <i class="bi bi-person-plus-fill me-2"></i>
                <span data-i18n="home:cta.register">Registrarse</span>
            </a>
            <a href="#"
               class="btn btn-outline-light btn-lg px-5 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                <span data-i18n="home:cta.login">Iniciar Sesión</span>
            </a>
        </div>
    </div>
</section>


@section Styles {
    <style>
        .hover-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

            .hover-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 30px rgba(0,0,0,.15) !important;
            }

        .carousel-slide {
            width: 100%;
        }
    </style>
}
